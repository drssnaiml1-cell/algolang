// Education — AI tutor that explains, quizzes and grades
model fast = "claude-haiku-5-5"
agent Tutor(topic: text, level: text = "first-year") -> text {
    goal "Explain {topic} for a {level} student in 6 sentences"
    model fast
}
agent QuizMaker(lesson: text) -> list {
    goal "Write 5 exam questions on: {lesson}"
}
agent Grader(lesson: text) -> score {
    goal "Score the lesson 0 to 1 for accuracy: {lesson}"
    policy { require human when confidence < 0.80 }
}
flow main(topic: text) {
    lesson = Tutor(topic)
    [quiz, quality] = par { QuizMaker(lesson), Grader(lesson) }
    if quality < 0.75 { lesson = Tutor(topic, level = "beginner") }
    emit lesson, quiz
}
