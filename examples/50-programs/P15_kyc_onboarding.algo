// KYC Onboarding: a pipeline of 3 agents.
model fast = "claude-haiku-5-5"
model smart = "claude-sonnet-5-5"

policy {
    budget tokens 4000
    retry 1
    forbid gender, caste, religion
    require human when confidence < 0.8
}

agent IdentityCheck(customer: text) -> text {
    role "KYC analyst"
    goal "Check that the identity documents in {customer} are complete and consistent"
    model smart
}

agent SanctionsScreen(identity: text) -> text {
    role "Compliance analyst"
    goal "Screen {identity} against sanctions and watch-list rules"
    model smart
}

agent OnboardingDecision(screening: text) -> text {
    role "Onboarding officer"
    goal "Recommend accept, hold or reject based on {screening}"
    model smart
}

flow main(customer: text) {
    identity = IdentityCheck(customer)
    screening = SanctionsScreen(identity)
    decision = OnboardingDecision(screening)
    emit decision
}
