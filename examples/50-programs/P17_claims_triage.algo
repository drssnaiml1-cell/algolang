// Claims Triage: a router that branches on a score.
model fast = "claude-haiku-5-5"
model smart = "claude-sonnet-5-5"

policy {
    budget tokens 5000
    retry 1
    require human when confidence < 0.8
}

agent ClaimRiskScorer(claim: text) -> score {
    role "Fraud analyst"
    goal "Score the fraud risk of {claim} from 0 to 1"
    model fast
}

agent SIUReferral(claim: text) -> text {
    role "Special investigations lead"
    goal "Write a referral to the investigation unit for {claim}"
    model smart
}

agent FastTrackPayout(claim: text) -> text {
    role "Claims adjuster"
    goal "Write a fast-track payout instruction for {claim}"
    model fast
}

flow main(claim: text) {
    risk = ClaimRiskScorer(claim)

       if risk >= 0.7 {
          referral = SIUReferral(claim)
          emit risk, referral
       } else {
          payout = FastTrackPayout(claim)
          emit risk, payout
       }
}
