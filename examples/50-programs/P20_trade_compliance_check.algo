// Trade Compliance Check: a router that branches on a score.
model fast = "claude-haiku-5-5"
model smart = "claude-sonnet-5-5"

policy {
    budget tokens 5000
    retry 1
    require human when confidence < 0.8
}

agent ComplianceScorer(trade: text) -> score {
    role "Compliance officer"
    goal "Score the policy-breach risk of {trade} from 0 to 1"
    model fast
}

agent EscalationNote(trade: text) -> text {
    role "Compliance officer"
    goal "Write an escalation note for {trade} for the compliance head"
    model smart
}

agent ClearanceNote(trade: text) -> text {
    role "Compliance officer"
    goal "Write a clearance note for {trade}"
    model fast
}

flow main(trade: text) {
    breach = ComplianceScorer(trade)

       if breach >= 0.6 {
          escalation = EscalationNote(trade)
          emit breach, escalation
       } else {
          clearance = ClearanceNote(trade)
          emit breach, clearance
       }
}
