// Discharge Summary: a pipeline of 3 agents.
model fast = "claude-haiku-5-5"
model smart = "claude-sonnet-5-5"

policy {
    budget tokens 5000
    retry 1
    require human when confidence < 0.8
}

agent Extractor(notes: text) -> text {
    role "Clinical coder"
    goal "Extract diagnoses, treatments and follow-ups from {notes}"
    model smart
}

agent SummaryDrafter(facts: text) -> text {
    role "Discharge clinician"
    goal "Draft a discharge summary from {facts} for clinician review"
    model smart
}

agent PlainLanguage(summary: text) -> text {
    role "Patient educator"
    goal "Rewrite {summary} in plain language for the patient"
    model fast
}

flow main(notes: text) {
    facts = Extractor(notes)
    summary = SummaryDrafter(facts)
    patient_copy = PlainLanguage(summary)
    emit patient_copy
}
