// Care Team Review: workers run in parallel, one agent merges.
model fast = "claude-haiku-5-5"
model smart = "claude-sonnet-5-5"

policy {
    budget tokens 5000
    retry 1
    require human when confidence < 0.8
}

agent CardiologyView(case: text) -> text {
    role "Cardiology reviewer"
    goal "List cardiac concerns for {case} for specialist follow-up"
    model smart
}

agent PharmacyView(case: text) -> text {
    role "Clinical pharmacist"
    goal "List medication concerns for {case} for review"
    model smart
}

agent NursingView(case: text) -> text {
    role "Ward nurse"
    goal "List nursing observations to monitor for {case}"
    model fast
}

agent Coordinator(cardio: text, pharmacy: text, nursing: text) -> text {
    role "Care coordinator"
    goal "Combine {cardio}, {pharmacy} and {nursing} into one action list for the care team"
    model smart
}

flow main(case: text) {
    [cardio, pharmacy, nursing] = par {
       CardiologyView(case),
       PharmacyView(case),
       NursingView(case)
    }
    plan = Coordinator(cardio, pharmacy, nursing)
    emit plan
}
