// ─────────────────────────────────────────────────────────────
//  AlgoLang v0.3.2 grammar  —  AlgoProfessor AI R&D Solutions
//  Core rule: there are no functions. Every unit of work is an
//  `agent`; a `flow` only orchestrates agents.
// ─────────────────────────────────────────────────────────────

start: item*

?item: use_decl
     | model_decl
     | tool_decl
     | policy_decl
     | agent_decl
     | flow_decl
     | eval_decl
     | stream_decl

// use "shared/agents.algo"           import another file's models, tools and agents
// use pack insurance.claims_triage    import a domain pack from the library
// use pack legal.contract_review as legal   …and call its agents as legal.Agent(…)
use_decl: "use" STRING ["as" NAME]              -> use_file
        | "use" "pack" DOTTED ["as" NAME]       -> use_pack

// policy { … } at top level: default policy for every agent in this file
policy_decl: "policy" "{" policy_rule* "}"

// model fast = "claude-haiku-5-5"
model_decl: "model" NAME "=" STRING

// tool web.search                              (declares a tool agents may be granted)
// tool kb.search_policies from mcp "company-kb"  (binds it to a tool on an MCP server)
tool_decl: "tool" DOTTED ["from" "mcp" STRING]

// agent Name(p: type, q: type = "x") -> type { ... }
agent_decl: "agent" NAME "(" [params] ")" "->" type "{" agent_clause* "}"

params: param ("," param)*
param: NAME ":" type ["=" literal]

// text | score | list | json | bool   — or uncertain<score>: sampled several times, carries its confidence
?type: NAME
     | "uncertain" "<" NAME ">"          -> uncertain_type

?agent_clause: "role" STRING            -> role
             | "goal" STRING            -> goal
             | "uses" DOTTED ("," DOTTED)* -> uses
             | "model" NAME             -> model_ref
             | "policy" "{" policy_rule* "}" -> policy

?policy_rule: "budget" "tokens" NUMBER                       -> budget
            | "budget" "cost" NUMBER [NAME]                  -> budget_cost     // usd (default) or inr
            | "budget" "energy" NUMBER NAME                  -> budget_energy   // wh or kwh
            | "samples" NUMBER                               -> samples         // for uncertain<T> agents
            | "shots" NUMBER                                 -> shots           // quantum.* tools: measurements per circuit
            | "max" "qubits" NUMBER                          -> max_qubits      // quantum.* tools: largest circuit allowed
            | "retry" NUMBER                                 -> retry
            | "require" "human" "when" "confidence" "<" NUMBER -> human_gate
            | "forbid" NAME ("," NAME)*                      -> forbid
            | "timeout" NUMBER                               -> timeout
            | "cache"                                        -> cache

// flow main(topic: text) { ... }
flow_decl: "flow" NAME "(" [params] ")" "{" stmt* "}"

?stmt: target "=" expr                                   -> assign
     | "if" condition "{" stmt* "}" ["else" "{" stmt* "}"]    -> if_stmt
     | "emit" expr ("," expr)*                           -> emit
     | call                                              -> expr_stmt

target: NAME                         -> single_target
      | "[" NAME ("," NAME)* "]"     -> multi_target

?expr: call
     | par_block
     | par_for
     | NAME                          -> var
     | literal

call: (NAME | DOTTED) "(" [args] ")"
args: arg ("," arg)*
?arg: kwarg | expr
kwarg: NAME "=" expr

// [a, b] = par { Writer(x), Critic(x) }
par_block: "par" "{" call ("," call)* "}"

// results = par for t in tasks { Worker(t) }
par_for: "par" "for" NAME "in" NAME "{" call "}"

// if risk > 0.8 and risk.confidence >= 0.7 { ... }
?condition: cond_and
          | condition "or" cond_and        -> or_cond
?cond_and: cond
         | cond_and "and" cond             -> and_cond
cond: operand COMPARE operand
    | operand "contains" STRING            -> contains_cond     // deterministic text guard (no model involved)
    | operand "not" "contains" STRING      -> not_contains_cond
?operand: expr
        | DOTTED                           -> attr

// eval regression on main {
//     case "small claim" (claim = "…") { expect called Routing  expect tokens < 2000 }
// }
eval_decl: "eval" NAME ["on" NAME] "{" eval_case* "}"
eval_case: "case" STRING "(" [args] ")" "{" expectation* "}"
?expectation: "expect" "status" NAME                       -> exp_status
            | "expect" "called" (NAME | DOTTED)            -> exp_called
            | "expect" "not" "called" (NAME | DOTTED)      -> exp_not_called
            | "expect" "tool" DOTTED                       -> exp_tool
            | "expect" "output" "contains" STRING          -> exp_contains
            | "expect" "emits" NUMBER                      -> exp_emits
            | "expect" "tokens" COMPARE NUMBER             -> exp_tokens
            | "expect" "cost" COMPARE NUMBER               -> exp_cost
            | "expect" "energy" COMPARE NUMBER             -> exp_energy
            | "expect" "escalated" COMPARE NUMBER          -> exp_escalated
            | "expect" "confidence" COMPARE NUMBER         -> exp_confidence
// Real-time events (v0.3.1): bind a flow to Kafka topics. Every event runs the flow once.
// stream order_flow on main {
//     from kafka "market" topic "orders.intent" group "risk-gate"
//     map order = event.order          key event.order_id
//     to topic "orders.decisions"      escalate to topic "orders.review"
//     dead letter topic "orders.dlq"   max in flight 8
// }
stream_decl: "stream" NAME ["on" NAME] "{" stream_clause* "}"
?stream_clause: "from" "kafka" STRING "topic" STRING ["group" STRING] -> st_source
              | "to" "topic" STRING                                   -> st_sink
              | "escalate" "to" "topic" STRING                        -> st_escalate
              | "dead" "letter" "topic" STRING                        -> st_dlq
              | "map" st_map ("," st_map)*                            -> st_maps
              | "key" (DOTTED | NAME)                                 -> st_key
              | "max" "in" "flight" NUMBER                            -> st_inflight
st_map: NAME "=" (DOTTED | NAME)

COMPARE: "<=" | ">=" | "==" | "!=" | "<" | ">"

?literal: STRING -> string
        | NUMBER -> number
        | "true"  -> true
        | "false" -> false

DOTTED: /[a-zA-Z_][a-zA-Z0-9_]*(\.[a-zA-Z_][a-zA-Z0-9_]*)+/
NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
STRING: /"([^"\\]|\\.)*"/
NUMBER: /\d+(\.\d+)?/

COMMENT: /\/\/[^\n]*/
%ignore COMMENT
%import common.WS
%ignore WS
SEMI: ";"
%ignore SEMI
