{
  "organisation": "AlgoGraph AI Platform Team (example organisation)",
  "policy": {
    "forbid": ["gender", "caste", "religion"],
    "max_budget_tokens": 8000,
    "min_human_below": 0.6,
    "allowed_tools": ["kb.search", "slm.triage", "graph.analyze", "graph.optimize"]
  },
  "max_concurrency": 16,
  "max_run_tokens": 120000,
  "cache": {"enabled": true},
  "audit_dir": "runs",
  "models": {
    "slm": "local:phi-4-mini",
    "mid": "claude-haiku-5-5",
    "llm": "claude-opus-5-5"
  },
  "local_models": {"base_url": "http://localhost:11434/v1", "timeout_s": 60},
  "agent_models": {},
  "pricing": {"local:*": [0.0, 0.0], "claude-opus-5-5": [15.0, 75.0], "claude-haiku-5-5": [1.0, 5.0]},
  "energy": {"wh_per_1k_tokens": {"local:*": 0.03, "claude-opus-5-5": 0.6, "claude-haiku-5-5": 0.1}},
  "tools": {"kb.search": {"dir": "kb"}},
  "plugins": ["plugins/graph_tools.py"]
}
