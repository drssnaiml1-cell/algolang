{
  "organisation": "Deccan Cooperative Bank (example organisation)",
  "policy": {
    "forbid": [
      "gender",
      "caste",
      "religion",
      "nationality",
      "marital_status"
    ],
    "max_budget_tokens": 8000,
    "min_human_below": 0.8,
    "allowed_tools": [
      "file.read",
      "calc.eval",
      "bureau.score",
      "sanctions.screen",
      "dti.calc"
    ]
  },
  "max_concurrency": 16,
  "max_run_tokens": 80000,
  "cache": {
    "enabled": true
  },
  "audit_dir": "runs",
  "models": {
    "smart": "claude-sonnet-5-5",
    "fast": "claude-haiku-5-5"
  },
  "tools": {
    "kb.search": {
      "dir": "kb"
    },
    "file.read": {
      "root": "data"
    }
  },
  "plugins": [
    "plugins/deccan_tools.py"
  ]
}
