{
  "organisation": "Deccan Institute of Technology (example organisation)",
  "policy": {
    "forbid": [
      "gender",
      "caste",
      "religion",
      "nationality",
      "income"
    ],
    "max_budget_tokens": 8000,
    "min_human_below": 0.75,
    "allowed_tools": [
      "kb.search",
      "file.read",
      "seats.lookup"
    ]
  },
  "max_concurrency": 16,
  "max_run_tokens": 80000,
  "cache": {
    "enabled": true
  },
  "audit_dir": "runs",
  "models": {
    "smart": "claude-sonnet-5-5",
    "fast": "claude-haiku-5-5"
  },
  "tools": {
    "kb.search": {
      "dir": "kb"
    },
    "file.read": {
      "root": "data"
    }
  },
  "plugins": [
    "plugins/university_tools.py"
  ]
}
