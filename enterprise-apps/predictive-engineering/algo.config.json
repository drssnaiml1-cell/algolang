{
  "organisation": "AlgoEng Predictive Maintenance (example plant operator, synthetic data)",
  "policy": {
    "forbid": [
      "gender",
      "caste",
      "religion"
    ],
    "max_budget_tokens": 8000,
    "min_human_below": 0.75,
    "allowed_tools": [
      "vib.diagnose",
      "rul.estimate",
      "fleet.scan",
      "maint.plan",
      "kb.search"
    ]
  },
  "max_concurrency": 8,
  "max_run_tokens": 80000,
  "max_run_cost_usd": 0.5,
  "cache": {
    "enabled": true
  },
  "audit_dir": "runs",
  "models": {
    "smart": "claude-sonnet-5-5",
    "fast": "claude-haiku-5-5"
  },
  "tools": {
    "kb.search": {
      "dir": "kb"
    }
  },
  "plugins": [
    "plugins/maintenance_tools.py"
  ]
}
