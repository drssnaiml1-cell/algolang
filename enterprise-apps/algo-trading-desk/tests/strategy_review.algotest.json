        "max_tokens": 2700
      }
    },
    {
      "name": "Martingale strategy fails the desk thresholds",
      "inputs": {
        "strategy": "STR-104 martingale: double the position after every loss on NIFTY futures"
      },
      "expect": {
        "status": "ok",
        "agents_called": [
          "Backtest",
          "Revisions"
        ],
        "agents_not_called": [
          "Robustness",
          "PaperApproval"
        ],
        "tools_used": [
          "backtest.stats"
        ],
        "output_contains": "FAILS desk thresholds",
        "emits": 3,
        "max_tokens": 1300
      }
    }
  ]
}