{
  "organisation": "Helix Cloud Services (example organisation)",
  "policy": {
    "forbid": [
      "gender",
      "caste",
      "religion"
    ],
    "max_budget_tokens": 8000,
    "min_human_below": 0.8,
    "allowed_tools": [
      "kb.search",
      "cmdb.lookup",
      "ioc.check"
    ]
  },
  "max_concurrency": 16,
  "max_run_tokens": 100000,
  "cache": {
    "enabled": true
  },
  "audit_dir": "runs",
  "models": {
    "smart": "claude-sonnet-5-5",
    "fast": "claude-haiku-5-5"
  },
  "tools": {
    "kb.search": {
      "dir": "kb"
    },
    "file.read": {
      "root": "data"
    }
  },
  "plugins": [
    "plugins/helix_tools.py"
  ]
}
