// Capital Markets & Investment · Earnings call summariser
// Summarise earnings calls into investor briefs
// AlgoLang domain pack markets.earnings_call · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 3000
    retry 1
}

agent Sections(transcript: text) -> list {
    role  "Sections specialist, earnings call summariser"
    goal  "Split {transcript} into management remarks and Q&A topics"
    uses  file.read
    model fast
}

agent Analyst(part: text, transcript: text) -> text {
    role  "Analyst specialist, earnings call summariser"
    goal  "Summarise key numbers and guidance in {part}"
}

agent Sentiment(findings: list) -> score {
    role  "Sentiment specialist, earnings call summariser"
    goal  "Score management confidence 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Brief(findings: list, level: score) -> text {
    role  "Brief specialist, earnings call summariser"
    goal  "Write an earnings brief from {findings} with confidence {level}"
}

flow main(transcript: text) {
    parts    = Sections(transcript)
    findings = par for part in parts { Analyst(part, transcript) }
    level    = Sentiment(findings)
    report   = Brief(findings, level)
    emit report, level
}
