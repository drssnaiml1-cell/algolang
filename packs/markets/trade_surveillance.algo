// Capital Markets & Investment · Trade surveillance
// Review trading alerts for market abuse
// AlgoLang domain pack markets.trade_surveillance · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Splitter(trades: text) -> list {
    role  "Splitter specialist, trade surveillance"
    goal  "Split {trades} into trade alerts"
    model fast
}

agent Investigator(part: text, trades: text) -> text {
    role  "Investigator specialist, trade surveillance"
    goal  "Assess {part} for market abuse patterns"
}

agent Concern(findings: list) -> score {
    role  "Concern specialist, trade surveillance"
    goal  "Score overall surveillance concern 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Report(findings: list, level: score) -> text {
    role  "Report specialist, trade surveillance"
    goal  "Write a surveillance report from {findings} with concern {level}"
}

flow main(trades: text) {
    parts    = Splitter(trades)
    findings = par for part in parts { Investigator(part, trades) }
    level    = Concern(findings)
    report   = Report(findings, level)
    emit report, level
}
