// Capital Markets & Investment · Research note review
// Pre-publication review of research notes
// AlgoLang domain pack markets.research_review · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent Analyst(note: text) -> text {
    role  "Analyst specialist, research note review"
    goal  "Check the investment thesis in {note}"
}

agent Compliance(note: text) -> text {
    role  "Compliance specialist, research note review"
    goal  "Check {note} for regulatory disclosure issues"
}

agent Editor(note: text) -> text {
    role  "Editor specialist, research note review"
    goal  "Check clarity and evidence in {note}"
}

agent Reviewers(views: list) -> score {
    role  "Reviewers specialist, research note review"
    goal  "Score readiness to publish 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
    }
}

agent Feedback(views: list, verdict: score) -> text {
    role  "Feedback specialist, research note review"
    goal  "Write review feedback from {views} with readiness {verdict}"
}

flow main(note: text) {
    views   = par { Analyst(note), Compliance(note), Editor(note) }
    verdict = Reviewers(views)
    report  = Feedback(views, verdict)
    emit report, verdict
}
