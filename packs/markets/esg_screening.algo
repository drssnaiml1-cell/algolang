// Capital Markets & Investment · ESG screening
// Three-pillar ESG review of companies
// AlgoLang domain pack markets.esg_screening · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 4000
    retry 1
}

agent Environmental(company: text) -> text {
    role  "Environmental specialist, esg screening"
    goal  "Assess environmental performance of {company}"
    uses  web.search
}

agent Social(company: text) -> text {
    role  "Social specialist, esg screening"
    goal  "Assess social and labour practices of {company}"
}

agent Governance(company: text) -> text {
    role  "Governance specialist, esg screening"
    goal  "Assess governance quality of {company}"
}

agent ESGPanel(views: list) -> score {
    role  "E s g panel specialist, esg screening"
    goal  "Score overall ESG quality 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
    }
}

agent Report(views: list, verdict: score) -> text {
    role  "Report specialist, esg screening"
    goal  "Write an ESG screening note from {views} with score {verdict}"
}

flow main(company: text) {
    views   = par { Environmental(company), Social(company), Governance(company) }
    verdict = ESGPanel(views)
    report  = Report(views, verdict)
    emit report, verdict
}
