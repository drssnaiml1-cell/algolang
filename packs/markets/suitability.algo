// Capital Markets & Investment · Client suitability check
// Check investment suitability for clients
// AlgoLang domain pack markets.suitability · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Profiler(client_profile: text) -> text {
    role  "Profiler specialist, client suitability check"
    goal  "Summarise risk tolerance and goals in {client_profile}"
}

agent Matcher(draft: text) -> text {
    role  "Matcher specialist, client suitability check"
    goal  "Assess product suitability for {draft}"
}

agent Suitability(work: text) -> score {
    role  "Suitability specialist, client suitability check"
    goal  "Score suitability 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Record(work: text, level: score) -> text {
    role  "Record specialist, client suitability check"
    goal  "Write a suitability record from {work} with score {level}"
}

flow main(client_profile: text) {
    first  = Profiler(client_profile)
    work   = Matcher(first)
    level  = Suitability(work)
    report = Record(work, level)
    emit report, level
}
