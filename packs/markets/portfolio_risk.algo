// Capital Markets & Investment · Portfolio risk brief
// Portfolio risk briefs for investment committees
// AlgoLang domain pack markets.portfolio_risk · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 6000
    retry 1
}

agent Exposures(portfolio: text) -> text {
    role  "Exposures specialist, portfolio risk brief"
    goal  "Summarise sector and factor exposures in {portfolio}"
    uses  calc.eval
}

agent Stress(draft: text) -> text {
    role  "Stress specialist, portfolio risk brief"
    goal  "Describe stress-scenario impacts on {draft}"
}

agent RiskLevel(work: text) -> score {
    role  "Risk level specialist, portfolio risk brief"
    goal  "Score portfolio risk 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
    }
}

agent Brief(work: text, level: score) -> text {
    role  "Brief specialist, portfolio risk brief"
    goal  "Write a risk brief for the investment committee from {work} with risk {level}"
}

flow main(portfolio: text) {
    first  = Exposures(portfolio)
    work   = Stress(first)
    level  = RiskLevel(work)
    report = Brief(work, level)
    emit report, level
}
