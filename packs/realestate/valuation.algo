// Real Estate & Construction · Property valuation brief
// Three-method property valuation briefs
// AlgoLang domain pack realestate.valuation · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 4000
    retry 1
}

agent MarketAnalyst(property: text) -> text {
    role  "Market analyst specialist, property valuation brief"
    goal  "Estimate value from comparables for {property}"
    uses  calc.eval
}

agent IncomeAnalyst(property: text) -> text {
    role  "Income analyst specialist, property valuation brief"
    goal  "Estimate value from income for {property}"
}

agent CostAnalyst(property: text) -> text {
    role  "Cost analyst specialist, property valuation brief"
    goal  "Estimate value from replacement cost for {property}"
}

agent Panel(views: list) -> score {
    role  "Panel specialist, property valuation brief"
    goal  "Score valuation confidence 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
    }
}

agent Report(views: list, verdict: score) -> text {
    role  "Report specialist, property valuation brief"
    goal  "Write a valuation brief from {views} with confidence {verdict}"
}

flow main(property: text) {
    views   = par { MarketAnalyst(property), IncomeAnalyst(property), CostAnalyst(property) }
    verdict = Panel(views)
    report  = Report(views, verdict)
    emit report, verdict
}
