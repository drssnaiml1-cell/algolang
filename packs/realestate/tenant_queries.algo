// Real Estate & Construction · Tenant query router
// Route tenant requests
// AlgoLang domain pack realestate.tenant_queries · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 3000
    retry 1
}

agent IsMaintenance(request: text) -> score {
    role  "Is maintenance specialist, tenant query router"
    goal  "Score 0 to 1 how likely this is a maintenance request: {request}"
    model fast
}

agent Maintenance(request: text) -> text {
    role  "Maintenance specialist, tenant query router"
    goal  "Create a maintenance work order for: {request}"
    uses  kb.search
}

agent Leasing(request: text) -> text {
    role  "Leasing specialist, tenant query router"
    goal  "Answer this lease or payment question: {request}"
    uses  kb.search
}

agent Clarity(reply: text) -> score {
    role  "Clarity specialist, tenant query router"
    goal  "Score 0 to 1 how clear this reply is: {reply}"
    policy {
        require human when confidence < 0.70
    }
}

flow main(request: text) {
    if IsMaintenance(request) >= 0.5 {
        reply = Maintenance(request)
    } else {
        reply = Leasing(request)
    }
    quality = Clarity(reply)
    if quality < 0.7 {
        reply = Maintenance(request)
    }
    emit reply, quality
}
