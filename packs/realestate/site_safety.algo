// Real Estate & Construction · Construction site safety audit
// Construction site safety audits
// AlgoLang domain pack realestate.site_safety · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Areas(site_report: text) -> list {
    role  "Areas specialist, construction site safety audit"
    goal  "List work areas in {site_report}"
    model fast
}

agent Inspector(part: text, site_report: text) -> text {
    role  "Inspector specialist, construction site safety audit"
    goal  "Find safety hazards in {part}"
}

agent Risk(findings: list) -> score {
    role  "Risk specialist, construction site safety audit"
    goal  "Score site safety risk 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
    }
}

agent Actions(findings: list, level: score) -> text {
    role  "Actions specialist, construction site safety audit"
    goal  "Write corrective actions from {findings} with risk {level}"
}

flow main(site_report: text) {
    parts    = Areas(site_report)
    findings = par for part in parts { Inspector(part, site_report) }
    level    = Risk(findings)
    report   = Actions(findings, level)
    emit report, level
}
