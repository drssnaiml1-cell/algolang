// Real Estate & Construction · Building code check
// Pre-check designs against building codes
// AlgoLang domain pack realestate.building_code · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Elements(design_summary: text) -> list {
    role  "Elements specialist, building code check"
    goal  "List design elements in {design_summary}"
    uses  kb.search
    model fast
}

agent Checker(part: text, design_summary: text) -> text {
    role  "Checker specialist, building code check"
    goal  "Check {part} against building code requirements"
}

agent Compliance(findings: list) -> score {
    role  "Compliance specialist, building code check"
    goal  "Score code compliance 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
    }
}

agent Report(findings: list, level: score) -> text {
    role  "Report specialist, building code check"
    goal  "Write a compliance report from {findings} with compliance {level}"
}

flow main(design_summary: text) {
    parts    = Elements(design_summary)
    findings = par for part in parts { Checker(part, design_summary) }
    level    = Compliance(findings)
    report   = Report(findings, level)
    emit report, level
}
