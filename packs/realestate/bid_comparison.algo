// Real Estate & Construction · Contractor bid comparison
// Compare contractor bids fairly
// AlgoLang domain pack realestate.bid_comparison · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 4000
    retry 1
}

agent CostEstimator(bids: text) -> text {
    role  "Cost estimator specialist, contractor bid comparison"
    goal  "Compare prices in {bids}"
    uses  calc.eval
}

agent Engineer(bids: text) -> text {
    role  "Engineer specialist, contractor bid comparison"
    goal  "Compare technical scope in {bids}"
}

agent RiskAnalyst(bids: text) -> text {
    role  "Risk analyst specialist, contractor bid comparison"
    goal  "Compare schedule and risk in {bids}"
}

agent Panel(views: list) -> score {
    role  "Panel specialist, contractor bid comparison"
    goal  "Score the preferred bid 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
    }
}

agent Recommendation(views: list, verdict: score) -> text {
    role  "Recommendation specialist, contractor bid comparison"
    goal  "Write a bid recommendation from {views} with score {verdict}"
}

flow main(bids: text) {
    views   = par { CostEstimator(bids), Engineer(bids), RiskAnalyst(bids) }
    verdict = Panel(views)
    report  = Recommendation(views, verdict)
    emit report, verdict
}
