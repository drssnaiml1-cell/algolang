// Real Estate & Construction · Lease abstraction
// Abstract key terms from leases
// AlgoLang domain pack realestate.lease_abstraction · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 4000
    retry 1
}

agent Clauses(lease: text) -> list {
    role  "Clauses specialist, lease abstraction"
    goal  "List key clauses in {lease}"
    uses  file.read
    model fast
}

agent Abstractor(part: text, lease: text) -> text {
    role  "Abstractor specialist, lease abstraction"
    goal  "Extract dates, amounts and obligations from {part}"
}

agent Risk(findings: list) -> score {
    role  "Risk specialist, lease abstraction"
    goal  "Score lease risk 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.80
    }
}

agent Abstract(findings: list, level: score) -> text {
    role  "Abstract specialist, lease abstraction"
    goal  "Write a lease abstract from {findings} with risk {level}"
}

flow main(lease: text) {
    parts    = Clauses(lease)
    findings = par for part in parts { Abstractor(part, lease) }
    level    = Risk(findings)
    report   = Abstract(findings, level)
    emit report, level
}
