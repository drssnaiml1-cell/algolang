// Research & Academia · Originality risk check
// Spot uncited claims and originality risks
// AlgoLang domain pack research.originality_check · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent Claims(text: text) -> text {
    role  "Claims specialist, originality risk check"
    goal  "List the main claims in {text}"
}

agent Overlap(draft: text) -> text {
    role  "Overlap specialist, originality risk check"
    goal  "Identify claims in {draft} that need citations"
}

agent Risk(work: text) -> score {
    role  "Risk specialist, originality risk check"
    goal  "Score originality risk 0 to 1 from {work}"
    policy {
        require human when confidence < 0.80
    }
}

agent Advice(work: text, level: score) -> text {
    role  "Advice specialist, originality risk check"
    goal  "Advise the author on {work} with risk {level}"
}

flow main(text: text) {
    first  = Claims(text)
    work   = Overlap(first)
    level  = Risk(work)
    report = Advice(work, level)
    emit report, level
}
