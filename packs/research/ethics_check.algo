// Research & Academia · Research ethics check
// Pre-screen protocols for the ethics committee
// AlgoLang domain pack research.ethics_check · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Risks(protocol: text) -> text {
    role  "Risks specialist, research ethics check"
    goal  "List risks to participants in {protocol}"
}

agent Consent(draft: text) -> text {
    role  "Consent specialist, research ethics check"
    goal  "Check consent and data handling in {draft}"
}

agent EthicsScore(work: text) -> score {
    role  "Ethics score specialist, research ethics check"
    goal  "Score ethical readiness 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
    }
}

agent Recommendation(work: text, level: score) -> text {
    role  "Recommendation specialist, research ethics check"
    goal  "Write an ethics committee note from {work} with score {level}"
}

flow main(protocol: text) {
    first  = Risks(protocol)
    work   = Consent(first)
    level  = EthicsScore(work)
    report = Recommendation(work, level)
    emit report, level
}
