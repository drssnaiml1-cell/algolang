// Research & Academia · Literature review
// Literature reviews for research scholars
// AlgoLang domain pack research.literature_review · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 4000
    retry 1
}

agent Searcher(question: text) -> list {
    role  "Searcher specialist, literature review"
    goal  "Find 6 key recent papers on {question}"
    uses  web.search
    model fast
}

agent Reader(part: text, question: text) -> text {
    role  "Reader specialist, literature review"
    goal  "Summarise method, data and findings of {part}"
}

agent Coverage(findings: list) -> score {
    role  "Coverage specialist, literature review"
    goal  "Score 0 to 1 how well {findings} cover the question"
    policy {
        require human when confidence < 0.80
    }
}

agent Writer(findings: list, level: score) -> text {
    role  "Writer specialist, literature review"
    goal  "Write a related-work section from {findings} with coverage {level}"
}

flow main(question: text) {
    parts    = Searcher(question)
    findings = par for part in parts { Reader(part, question) }
    level    = Coverage(findings)
    report   = Writer(findings, level)
    emit report, level
}
