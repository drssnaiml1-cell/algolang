// Research & Academia · Thesis chapter feedback
// Supervisor-style feedback on thesis chapters
// AlgoLang domain pack research.thesis_feedback · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent Sections(chapter: text) -> list {
    role  "Sections specialist, thesis chapter feedback"
    goal  "Split {chapter} into sections"
    model fast
}

agent Supervisor(part: text, chapter: text) -> text {
    role  "Supervisor specialist, thesis chapter feedback"
    goal  "Give supervisor feedback on {part}"
}

agent Readiness(findings: list) -> score {
    role  "Readiness specialist, thesis chapter feedback"
    goal  "Score submission readiness 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.80
    }
}

agent Plan(findings: list, level: score) -> text {
    role  "Plan specialist, thesis chapter feedback"
    goal  "Write a revision plan from {findings} with readiness {level}"
}

flow main(chapter: text) {
    parts    = Sections(chapter)
    findings = par for part in parts { Supervisor(part, chapter) }
    level    = Readiness(findings)
    report   = Plan(findings, level)
    emit report, level
}
