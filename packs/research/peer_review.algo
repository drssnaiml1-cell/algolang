// Research & Academia · Manuscript peer review
// Editorial first-round peer review
// AlgoLang domain pack research.peer_review · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 6000
    retry 1
}

agent Criteria(manuscript: text) -> list {
    role  "Criteria specialist, manuscript peer review"
    goal  "List the review criteria that matter most for {manuscript}"
    uses  file.read
    model fast
}

agent Reviewer(part: text, manuscript: text) -> text {
    role  "Reviewer specialist, manuscript peer review"
    goal  "Review {part} for the manuscript {manuscript}"
}

agent Editor(findings: list) -> score {
    role  "Editor specialist, manuscript peer review"
    goal  "Score acceptance likelihood 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Letter(findings: list, level: score) -> text {
    role  "Letter specialist, manuscript peer review"
    goal  "Draft a decision letter from {findings} with score {level}"
}

flow main(manuscript: text) {
    parts    = Criteria(manuscript)
    findings = par for part in parts { Reviewer(part, manuscript) }
    level    = Editor(findings)
    report   = Letter(findings, level)
    emit report, level
}
