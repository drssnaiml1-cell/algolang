// Research & Academia · Grant proposal review
// Panel review of research grant proposals
// AlgoLang domain pack research.grant_review · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent ScienceReviewer(proposal: text) -> text {
    role  "Science reviewer specialist, grant proposal review"
    goal  "Assess scientific merit of {proposal}"
}

agent FeasibilityReviewer(proposal: text) -> text {
    role  "Feasibility reviewer specialist, grant proposal review"
    goal  "Assess feasibility and budget of {proposal}"
}

agent ImpactReviewer(proposal: text) -> text {
    role  "Impact reviewer specialist, grant proposal review"
    goal  "Assess societal impact of {proposal}"
}

agent Panel(views: list) -> score {
    role  "Panel specialist, grant proposal review"
    goal  "Score funding priority 0 to 1 from {views}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Summary(views: list, verdict: score) -> text {
    role  "Summary specialist, grant proposal review"
    goal  "Write a panel summary from {views} with priority {verdict}"
}

flow main(proposal: text) {
    views   = par { ScienceReviewer(proposal), FeasibilityReviewer(proposal), ImpactReviewer(proposal) }
    verdict = Panel(views)
    report  = Summary(views, verdict)
    emit report, verdict
}
