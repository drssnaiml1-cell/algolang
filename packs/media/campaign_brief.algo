// Media & Marketing · Campaign brief
// Marketing campaign briefs
// AlgoLang domain pack media.campaign_brief · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 3000
    retry 1
}

agent Strategist(product_goal: text) -> text {
    role  "Strategist specialist, campaign brief"
    goal  "Define audience and message for {product_goal}"
}

agent Creative(draft: text) -> text {
    role  "Creative specialist, campaign brief"
    goal  "Write three campaign concepts from {draft}"
}

agent Fit(work: text) -> score {
    role  "Fit specialist, campaign brief"
    goal  "Score brand fit 0 to 1 of {work}"
    policy {
        require human when confidence < 0.70
    }
}

agent Brief(work: text, level: score) -> text {
    role  "Brief specialist, campaign brief"
    goal  "Write a campaign brief from {work} with fit {level}"
}

flow main(product_goal: text) {
    first  = Strategist(product_goal)
    work   = Creative(first)
    level  = Fit(work)
    report = Brief(work, level)
    emit report, level
}
