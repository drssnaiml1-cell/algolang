// Media & Marketing · Audience segment brief
// Audience segments and personas
// AlgoLang domain pack media.audience_segments · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent Segmenter(customer_data: text) -> text {
    role  "Segmenter specialist, audience segment brief"
    goal  "Describe customer segments in {customer_data}"
}

agent Personas(draft: text) -> text {
    role  "Personas specialist, audience segment brief"
    goal  "Write a persona for each segment in {draft}"
}

agent Value(work: text) -> score {
    role  "Value specialist, audience segment brief"
    goal  "Score segment value 0 to 1 from {work}"
    policy {
        require human when confidence < 0.80
        forbid gender, caste, religion, nationality
    }
}

agent Brief(work: text, level: score) -> text {
    role  "Brief specialist, audience segment brief"
    goal  "Write a targeting brief from {work} with value {level}"
}

flow main(customer_data: text) {
    first  = Segmenter(customer_data)
    work   = Personas(first)
    level  = Value(work)
    report = Brief(work, level)
    emit report, level
}
