// Media & Marketing · Press release writer
// Fact-checked press releases
// AlgoLang domain pack media.press_release · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent Facts(announcement: text) -> text {
    role  "Facts specialist, press release writer"
    goal  "List the key facts in {announcement}"
}

agent Writer(draft: text) -> text {
    role  "Writer specialist, press release writer"
    goal  "Write a press release from {draft}"
}

agent Accuracy(work: text) -> score {
    role  "Accuracy specialist, press release writer"
    goal  "Score factual accuracy 0 to 1 of {work}"
    policy {
        require human when confidence < 0.80
    }
}

agent Final(work: text, level: score) -> text {
    role  "Final specialist, press release writer"
    goal  "Finalise the release {work} with accuracy {level}"
}

flow main(announcement: text) {
    first  = Facts(announcement)
    work   = Writer(first)
    level  = Accuracy(work)
    report = Final(work, level)
    emit report, level
}
