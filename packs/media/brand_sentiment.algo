// Media & Marketing · Brand sentiment monitor
// Track brand sentiment
// AlgoLang domain pack media.brand_sentiment · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 3000
    retry 1
}

agent Splitter(mentions: text) -> list {
    role  "Splitter specialist, brand sentiment monitor"
    goal  "Split {mentions} into individual mentions"
    model fast
}

agent Analyst(part: text, mentions: text) -> text {
    role  "Analyst specialist, brand sentiment monitor"
    goal  "Classify sentiment and topic of {part}"
}

agent Sentiment(findings: list) -> score {
    role  "Sentiment specialist, brand sentiment monitor"
    goal  "Score overall brand sentiment 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Report(findings: list, level: score) -> text {
    role  "Report specialist, brand sentiment monitor"
    goal  "Write a sentiment report from {findings} with score {level}"
}

flow main(mentions: text) {
    parts    = Splitter(mentions)
    findings = par for part in parts { Analyst(part, mentions) }
    level    = Sentiment(findings)
    report   = Report(findings, level)
    emit report, level
}
