// Media & Marketing · SEO content audit
// Audit web pages for SEO
// AlgoLang domain pack media.seo_audit · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 3000
    retry 1
}

agent Pages(pages: text) -> list {
    role  "Pages specialist, seo content audit"
    goal  "List the pages in {pages}"
    uses  web.search
    model fast
}

agent Auditor(part: text, pages: text) -> text {
    role  "Auditor specialist, seo content audit"
    goal  "Check {part} for SEO and readability issues"
}

agent Health(findings: list) -> score {
    role  "Health specialist, seo content audit"
    goal  "Score SEO health 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Plan(findings: list, level: score) -> text {
    role  "Plan specialist, seo content audit"
    goal  "Write an SEO fix plan from {findings} with health {level}"
}

flow main(pages: text) {
    parts    = Pages(pages)
    findings = par for part in parts { Auditor(part, pages) }
    level    = Health(findings)
    report   = Plan(findings, level)
    emit report, level
}
