// Media & Marketing · Content moderation
// Consistent content moderation decisions
// AlgoLang domain pack media.content_moderation · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent SafetyReviewer(post: text) -> text {
    role  "Safety reviewer specialist, content moderation"
    goal  "Check {post} for harmful content"
    uses  kb.search
}

agent PolicyReviewer(post: text) -> text {
    role  "Policy reviewer specialist, content moderation"
    goal  "Check {post} against community guidelines"
}

agent ContextReviewer(post: text) -> text {
    role  "Context reviewer specialist, content moderation"
    goal  "Consider context and intent of {post}"
}

agent ModerationPanel(views: list) -> score {
    role  "Moderation panel specialist, content moderation"
    goal  "Score removal need 0 to 1 from {views}"
    policy {
        require human when confidence < 0.90
    }
}

agent Decision(views: list, verdict: score) -> text {
    role  "Decision specialist, content moderation"
    goal  "Write a moderation decision with reasons from {views} with score {verdict}"
}

flow main(post: text) {
    views   = par { SafetyReviewer(post), PolicyReviewer(post), ContextReviewer(post) }
    verdict = ModerationPanel(views)
    report  = Decision(views, verdict)
    emit report, verdict
}
