// Banking · Card fraud case review
// Review suspected card-fraud cases
// AlgoLang domain pack banking.fraud_cases · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Splitter(cases: text) -> list {
    role  "Splitter specialist, card fraud case review"
    goal  "Split {cases} into individual fraud cases"
    model fast
}

agent Analyst(part: text, cases: text) -> text {
    role  "Analyst specialist, card fraud case review"
    goal  "Assess {part} for fraud indicators given {cases}"
}

agent FraudScore(findings: list) -> score {
    role  "Fraud score specialist, card fraud case review"
    goal  "Score overall fraud likelihood 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Report(findings: list, level: score) -> text {
    role  "Report specialist, card fraud case review"
    goal  "Write a fraud review report from {findings} with likelihood {level}"
}

flow main(cases: text) {
    parts    = Splitter(cases)
    findings = par for part in parts { Analyst(part, cases) }
    level    = FraudScore(findings)
    report   = Report(findings, level)
    emit report, level
}
