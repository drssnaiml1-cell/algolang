// Banking · Loan underwriting assistant
// Committee-style loan assessment with fairness safeguards
// AlgoLang domain pack banking.loan_underwriting · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 6000
    retry 1
}

agent CreditAnalyst(application: text) -> text {
    role  "Credit analyst specialist, loan underwriting assistant"
    goal  "Assess repayment capacity in {application}"
    uses  calc.eval
}

agent RiskAnalyst(application: text) -> text {
    role  "Risk analyst specialist, loan underwriting assistant"
    goal  "Identify credit risks in {application}"
}

agent PolicyChecker(application: text) -> text {
    role  "Policy checker specialist, loan underwriting assistant"
    goal  "Check {application} against lending policy"
}

agent CreditCommittee(views: list) -> score {
    role  "Credit committee specialist, loan underwriting assistant"
    goal  "Score approval likelihood 0 to 1 from {views}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Memo(views: list, verdict: score) -> text {
    role  "Memo specialist, loan underwriting assistant"
    goal  "Write a credit decision memo from {views} with score {verdict}"
}

flow main(application: text) {
    views   = par { CreditAnalyst(application), RiskAnalyst(application), PolicyChecker(application) }
    verdict = CreditCommittee(views)
    report  = Memo(views, verdict)
    emit report, verdict
}
