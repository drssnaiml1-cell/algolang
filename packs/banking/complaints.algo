// Banking · Customer complaint router
// Route complaints by severity and draft responses
// AlgoLang domain pack banking.complaints · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent Severity(complaint: text) -> score {
    role  "Severity specialist, customer complaint router"
    goal  "Score 0 to 1 how serious and regulatory-sensitive this complaint is: {complaint}"
    model fast
}

agent Escalations(complaint: text) -> text {
    role  "Escalations specialist, customer complaint router"
    goal  "Draft an escalation response and remediation plan for: {complaint}"
}

agent ServiceDesk(complaint: text) -> text {
    role  "Service desk specialist, customer complaint router"
    goal  "Draft a helpful standard response for: {complaint}"
}

agent ToneCheck(reply: text) -> score {
    role  "Tone check specialist, customer complaint router"
    goal  "Score 0 to 1 how empathetic and clear this reply is: {reply}"
    policy {
        require human when confidence < 0.80
    }
}

flow main(complaint: text) {
    if Severity(complaint) >= 0.5 {
        reply = Escalations(complaint)
    } else {
        reply = ServiceDesk(complaint)
    }
    quality = ToneCheck(reply)
    if quality < 0.7 {
        reply = Escalations(complaint)
    }
    emit reply, quality
}
