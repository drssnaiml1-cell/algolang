// Banking · AML alert triage
// Triage AML alerts and draft investigation summaries
// AlgoLang domain pack banking.aml_alerts · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Batcher(alerts: text) -> list {
    role  "Batcher specialist, aml alert triage"
    goal  "Split {alerts} into individual AML alerts"
    uses  kb.search
    model fast
}

agent Investigator(part: text, alerts: text) -> text {
    role  "Investigator specialist, aml alert triage"
    goal  "Investigate {part} for suspicious patterns within {alerts}"
}

agent Priority(findings: list) -> score {
    role  "Priority specialist, aml alert triage"
    goal  "Score overall escalation priority 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent SAR(findings: list, level: score) -> text {
    role  "S a r specialist, aml alert triage"
    goal  "Draft a suspicious-activity summary from {findings} with priority {level}"
}

flow main(alerts: text) {
    parts    = Batcher(alerts)
    findings = par for part in parts { Investigator(part, alerts) }
    level    = Priority(findings)
    report   = SAR(findings, level)
    emit report, level
}
