// Banking · KYC document review
// Review KYC files for completeness and risk
// AlgoLang domain pack banking.kyc_review · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 6000
    retry 1
}

agent DocChecker(customer_file: text) -> text {
    role  "Doc checker specialist, kyc document review"
    goal  "List KYC documents present and missing in {customer_file}"
    uses  file.read
}

agent Verifier(draft: text) -> text {
    role  "Verifier specialist, kyc document review"
    goal  "Check consistency of details across {draft}"
}

agent RiskRating(work: text) -> score {
    role  "Risk rating specialist, kyc document review"
    goal  "Score customer risk 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Outcome(work: text, level: score) -> text {
    role  "Outcome specialist, kyc document review"
    goal  "Write the KYC review outcome for {work} with risk {level}"
}

flow main(customer_file: text) {
    first  = DocChecker(customer_file)
    work   = Verifier(first)
    level  = RiskRating(work)
    report = Outcome(work, level)
    emit report, level
}
