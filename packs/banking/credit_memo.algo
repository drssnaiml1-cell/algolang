// Banking · Credit memo writer
// Draft credit memos from borrower data
// AlgoLang domain pack banking.credit_memo · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 4000
    retry 1
}

agent Financials(borrower: text) -> text {
    role  "Financials specialist, credit memo writer"
    goal  "Extract key financial ratios for {borrower}"
    uses  calc.eval
}

agent Analysis(draft: text) -> text {
    role  "Analysis specialist, credit memo writer"
    goal  "Analyse strengths and weaknesses from {draft}"
}

agent RiskScore(work: text) -> score {
    role  "Risk score specialist, credit memo writer"
    goal  "Score credit risk 0 to 1 from {work}"
    policy {
        require human when confidence < 0.80
        forbid gender, caste, religion, nationality
    }
}

agent Memo(work: text, level: score) -> text {
    role  "Memo specialist, credit memo writer"
    goal  "Write a credit memo from {work} with risk {level}"
}

flow main(borrower: text) {
    first  = Financials(borrower)
    work   = Analysis(first)
    level  = RiskScore(work)
    report = Memo(work, level)
    emit report, level
}
