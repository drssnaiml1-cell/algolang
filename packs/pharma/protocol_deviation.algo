// Pharma & Life Sciences · Protocol deviation assessment
// Assess trial protocol deviations and propose CAPA
// AlgoLang domain pack pharma.protocol_deviation · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Classifier(deviation: text) -> text {
    role  "Classifier specialist, protocol deviation assessment"
    goal  "Classify the protocol deviation in {deviation}"
}

agent Impact(draft: text) -> text {
    role  "Impact specialist, protocol deviation assessment"
    goal  "Assess impact of {draft} on subject safety and data integrity"
}

agent Severity(work: text) -> score {
    role  "Severity specialist, protocol deviation assessment"
    goal  "Score deviation severity 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
    }
}

agent CAPA(work: text, level: score) -> text {
    role  "C a p a specialist, protocol deviation assessment"
    goal  "Propose corrective and preventive actions for {work} with severity {level}"
}

flow main(deviation: text) {
    first  = Classifier(deviation)
    work   = Impact(first)
    level  = Severity(work)
    report = CAPA(work, level)
    emit report, level
}
