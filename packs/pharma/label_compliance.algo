// Pharma & Life Sciences · Product label compliance
// Check product labels against regulations
// AlgoLang domain pack pharma.label_compliance · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 4000
    retry 1
}

agent RegulatoryExpert(label: text) -> text {
    role  "Regulatory expert specialist, product label compliance"
    goal  "Check {label} against labelling regulations"
    uses  kb.search
}

agent MedicalWriter(label: text) -> text {
    role  "Medical writer specialist, product label compliance"
    goal  "Check clarity and accuracy of {label}"
}

agent QualityLead(label: text) -> text {
    role  "Quality lead specialist, product label compliance"
    goal  "Check {label} for version and artwork consistency"
}

agent ComplianceJudge(views: list) -> score {
    role  "Compliance judge specialist, product label compliance"
    goal  "Score label compliance 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
    }
}

agent Findings(views: list, verdict: score) -> text {
    role  "Findings specialist, product label compliance"
    goal  "List required label changes from {views} with score {verdict}"
}

flow main(label: text) {
    views   = par { RegulatoryExpert(label), MedicalWriter(label), QualityLead(label) }
    verdict = ComplianceJudge(views)
    report  = Findings(views, verdict)
    emit report, verdict
}
