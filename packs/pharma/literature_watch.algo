// Pharma & Life Sciences · Safety literature surveillance
// Weekly literature watch for drug safety signals
// AlgoLang domain pack pharma.literature_watch · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 4000
    retry 1
}

agent Searcher(drug: text) -> list {
    role  "Searcher specialist, safety literature surveillance"
    goal  "List recent publications mentioning {drug}"
    uses  web.search
    model fast
}

agent Reader(part: text, drug: text) -> text {
    role  "Reader specialist, safety literature surveillance"
    goal  "Extract any safety signals for {drug} from {part}"
}

agent SignalScore(findings: list) -> score {
    role  "Signal score specialist, safety literature surveillance"
    goal  "Score strength of new safety signals 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.80
    }
}

agent Digest(findings: list, level: score) -> text {
    role  "Digest specialist, safety literature surveillance"
    goal  "Write a surveillance digest from {findings} with signal strength {level}"
}

flow main(drug: text) {
    parts    = Searcher(drug)
    findings = par for part in parts { Reader(part, drug) }
    level    = SignalScore(findings)
    report   = Digest(findings, level)
    emit report, level
}
