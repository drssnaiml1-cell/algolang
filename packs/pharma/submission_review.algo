// Pharma & Life Sciences · Regulatory submission review
// Review regulatory dossiers section by section
// AlgoLang domain pack pharma.submission_review · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 6000
    retry 1
}

agent Sections(dossier: text) -> list {
    role  "Sections specialist, regulatory submission review"
    goal  "List the sections of {dossier} that need review"
    uses  file.read
    model fast
}

agent Reviewer(part: text, dossier: text) -> text {
    role  "Reviewer specialist, regulatory submission review"
    goal  "Review {part} of the dossier {dossier} for gaps"
}

agent Readiness(findings: list) -> score {
    role  "Readiness specialist, regulatory submission review"
    goal  "Score submission readiness 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
    }
}

agent GapReport(findings: list, level: score) -> text {
    role  "Gap report specialist, regulatory submission review"
    goal  "Write a gap report from {findings} with readiness {level}"
}

flow main(dossier: text) {
    parts    = Sections(dossier)
    findings = par for part in parts { Reviewer(part, dossier) }
    level    = Readiness(findings)
    report   = GapReport(findings, level)
    emit report, level
}
