// Pharma & Life Sciences · Clinical trial matching
// Match patient profiles to trial criteria for investigator review
// AlgoLang domain pack pharma.trial_matching · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Criteria(patient_profile: text) -> list {
    role  "Criteria specialist, clinical trial matching"
    goal  "List eligibility criteria relevant to {patient_profile}"
    uses  kb.search
    model fast
}

agent Matcher(part: text, patient_profile: text) -> text {
    role  "Matcher specialist, clinical trial matching"
    goal  "Check {part} against the profile {patient_profile}"
}

agent Eligibility(findings: list) -> score {
    role  "Eligibility specialist, clinical trial matching"
    goal  "Score overall trial eligibility 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
        forbid caste, religion
    }
}

agent Summary(findings: list, level: score) -> text {
    role  "Summary specialist, clinical trial matching"
    goal  "Summarise eligibility findings {findings} with score {level} for the investigator"
}

flow main(patient_profile: text) {
    parts    = Criteria(patient_profile)
    findings = par for part in parts { Matcher(part, patient_profile) }
    level    = Eligibility(findings)
    report   = Summary(findings, level)
    emit report, level
}
