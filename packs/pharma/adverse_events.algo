// Pharma & Life Sciences · Adverse event case processing
// Process adverse event reports into coded case narratives
// AlgoLang domain pack pharma.adverse_events · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Intake(case: text) -> text {
    role  "Intake specialist, adverse event case processing"
    goal  "Extract patient, drug, event and timing details from {case}"
    uses  kb.search
}

agent Coder(draft: text) -> text {
    role  "Coder specialist, adverse event case processing"
    goal  "Code the event in {draft} with MedDRA-style terms"
}

agent Seriousness(work: text) -> score {
    role  "Seriousness specialist, adverse event case processing"
    goal  "Score seriousness 0 to 1 of {work}"
    policy {
        require human when confidence < 0.90
        forbid caste, religion
    }
}

agent Narrative(work: text, level: score) -> text {
    role  "Narrative specialist, adverse event case processing"
    goal  "Write a pharmacovigilance case narrative from {work} with seriousness {level}"
}

flow main(case: text) {
    first  = Intake(case)
    work   = Coder(first)
    level  = Seriousness(work)
    report = Narrative(work, level)
    emit report, level
}
