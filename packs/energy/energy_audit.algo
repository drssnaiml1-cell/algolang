// Energy & Utilities · Building energy audit
// Find energy savings in buildings
// AlgoLang domain pack energy.energy_audit · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 3000
    retry 1
}

agent Systems(audit_data: text) -> list {
    role  "Systems specialist, building energy audit"
    goal  "List building systems in {audit_data}"
    uses  calc.eval
    model fast
}

agent Auditor(part: text, audit_data: text) -> text {
    role  "Auditor specialist, building energy audit"
    goal  "Find savings opportunities in {part}"
}

agent Savings(findings: list) -> score {
    role  "Savings specialist, building energy audit"
    goal  "Score savings potential 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Report(findings: list, level: score) -> text {
    role  "Report specialist, building energy audit"
    goal  "Write an energy audit report from {findings} with potential {level}"
}

flow main(audit_data: text) {
    parts    = Systems(audit_data)
    findings = par for part in parts { Auditor(part, audit_data) }
    level    = Savings(findings)
    report   = Report(findings, level)
    emit report, level
}
