// Energy & Utilities · Meter anomaly detection
// Find meter faults and possible theft
// AlgoLang domain pack energy.meter_anomaly · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 4000
    retry 1
}

agent Meters(meter_data: text) -> list {
    role  "Meters specialist, meter anomaly detection"
    goal  "List the meters in {meter_data}"
    uses  calc.eval
    model fast
}

agent Analyst(part: text, meter_data: text) -> text {
    role  "Analyst specialist, meter anomaly detection"
    goal  "Find consumption anomalies for {part}"
}

agent Risk(findings: list) -> score {
    role  "Risk specialist, meter anomaly detection"
    goal  "Score theft or fault likelihood 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.80
        forbid gender, caste, religion, nationality
    }
}

agent Report(findings: list, level: score) -> text {
    role  "Report specialist, meter anomaly detection"
    goal  "Write an inspection list from {findings} with risk {level}"
}

flow main(meter_data: text) {
    parts    = Meters(meter_data)
    findings = par for part in parts { Analyst(part, meter_data) }
    level    = Risk(findings)
    report   = Report(findings, level)
    emit report, level
}
