// Energy & Utilities · Outage response router
// Route outages to emergency or planned repair
// AlgoLang domain pack energy.outage_response · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Critical(outage_report: text) -> score {
    role  "Critical specialist, outage response router"
    goal  "Score 0 to 1 how critical this outage is: {outage_report}"
    model fast
}

agent Emergency(outage_report: text) -> text {
    role  "Emergency specialist, outage response router"
    goal  "Draft an emergency crew dispatch plan for: {outage_report}"
}

agent Planned(outage_report: text) -> text {
    role  "Planned specialist, outage response router"
    goal  "Draft a scheduled repair plan for: {outage_report}"
}

agent Clarity(reply: text) -> score {
    role  "Clarity specialist, outage response router"
    goal  "Score 0 to 1 how actionable this plan is: {reply}"
    policy {
        require human when confidence < 0.90
    }
}

flow main(outage_report: text) {
    if Critical(outage_report) >= 0.5 {
        reply = Emergency(outage_report)
    } else {
        reply = Planned(outage_report)
    }
    quality = Clarity(reply)
    if quality < 0.7 {
        reply = Emergency(outage_report)
    }
    emit reply, quality
}
