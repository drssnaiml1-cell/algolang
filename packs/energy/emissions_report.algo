// Energy & Utilities · Emissions report
// Greenhouse-gas emissions reporting
// AlgoLang domain pack energy.emissions_report · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 4000
    retry 1
}

agent Inventory(activity_data: text) -> text {
    role  "Inventory specialist, emissions report"
    goal  "Organise scope 1, 2 and 3 activity data in {activity_data}"
    uses  calc.eval
}

agent Calculator(draft: text) -> text {
    role  "Calculator specialist, emissions report"
    goal  "Estimate emissions from {draft}"
}

agent Quality(work: text) -> score {
    role  "Quality specialist, emissions report"
    goal  "Score data quality 0 to 1 of {work}"
    policy {
        require human when confidence < 0.80
    }
}

agent Report(work: text, level: score) -> text {
    role  "Report specialist, emissions report"
    goal  "Write an emissions report from {work} with quality {level}"
}

flow main(activity_data: text) {
    first  = Inventory(activity_data)
    work   = Calculator(first)
    level  = Quality(work)
    report = Report(work, level)
    emit report, level
}
