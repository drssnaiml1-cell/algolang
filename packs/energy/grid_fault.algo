// Energy & Utilities · Grid fault analysis
// Analyse grid protection events
// AlgoLang domain pack energy.grid_fault · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Events(fault_record: text) -> text {
    role  "Events specialist, grid fault analysis"
    goal  "Order the protection events in {fault_record}"
}

agent Cause(draft: text) -> text {
    role  "Cause specialist, grid fault analysis"
    goal  "Identify the likely fault cause from {draft}"
}

agent Confidence(work: text) -> score {
    role  "Confidence specialist, grid fault analysis"
    goal  "Score diagnosis confidence 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
    }
}

agent Report(work: text, level: score) -> text {
    role  "Report specialist, grid fault analysis"
    goal  "Write a fault report from {work} with confidence {level}"
}

flow main(fault_record: text) {
    first  = Events(fault_record)
    work   = Cause(first)
    level  = Confidence(work)
    report = Report(work, level)
    emit report, level
}
