// Energy & Utilities · Renewable site assessment
// Assess sites for renewable projects
// AlgoLang domain pack energy.renewable_site · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 4000
    retry 1
}

agent ResourceAnalyst(site: text) -> text {
    role  "Resource analyst specialist, renewable site assessment"
    goal  "Assess solar and wind resource at {site}"
    uses  web.search
}

agent GridAnalyst(site: text) -> text {
    role  "Grid analyst specialist, renewable site assessment"
    goal  "Assess grid connection for {site}"
}

agent EnvironmentAnalyst(site: text) -> text {
    role  "Environment analyst specialist, renewable site assessment"
    goal  "Assess environmental and land issues for {site}"
}

agent Panel(views: list) -> score {
    role  "Panel specialist, renewable site assessment"
    goal  "Score site suitability 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
    }
}

agent Report(views: list, verdict: score) -> text {
    role  "Report specialist, renewable site assessment"
    goal  "Write a site assessment from {views} with suitability {verdict}"
}

flow main(site: text) {
    views   = par { ResourceAnalyst(site), GridAnalyst(site), EnvironmentAnalyst(site) }
    verdict = Panel(views)
    report  = Report(views, verdict)
    emit report, verdict
}
