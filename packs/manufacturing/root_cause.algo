// Manufacturing · Root cause analysis
// Fishbone-style root cause analysis
// AlgoLang domain pack manufacturing.root_cause · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent ProcessEngineer(incident: text) -> text {
    role  "Process engineer specialist, root cause analysis"
    goal  "Find process causes of {incident}"
}

agent EquipmentEngineer(incident: text) -> text {
    role  "Equipment engineer specialist, root cause analysis"
    goal  "Find equipment causes of {incident}"
}

agent QualityEngineer(incident: text) -> text {
    role  "Quality engineer specialist, root cause analysis"
    goal  "Find material and method causes of {incident}"
}

agent RCAPanel(views: list) -> score {
    role  "R c a panel specialist, root cause analysis"
    goal  "Score confidence in the root cause 0 to 1 from {views}"
    policy {
        require human when confidence < 0.90
    }
}

agent Report(views: list, verdict: score) -> text {
    role  "Report specialist, root cause analysis"
    goal  "Write a 5-Whys RCA report from {views} with confidence {verdict}"
}

flow main(incident: text) {
    views   = par { ProcessEngineer(incident), EquipmentEngineer(incident), QualityEngineer(incident) }
    verdict = RCAPanel(views)
    report  = Report(views, verdict)
    emit report, verdict
}
