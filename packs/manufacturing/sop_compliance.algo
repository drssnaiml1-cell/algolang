// Manufacturing · SOP compliance audit
// Audit shop-floor compliance with SOPs
// AlgoLang domain pack manufacturing.sop_compliance · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 4000
    retry 1
}

agent Steps(sop: text) -> list {
    role  "Steps specialist, sop compliance audit"
    goal  "List the steps of {sop}"
    uses  kb.search
    model fast
}

agent Auditor(part: text, sop: text) -> text {
    role  "Auditor specialist, sop compliance audit"
    goal  "Check evidence that {part} is followed"
}

agent Compliance(findings: list) -> score {
    role  "Compliance specialist, sop compliance audit"
    goal  "Score SOP compliance 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.80
    }
}

agent Findings(findings: list, level: score) -> text {
    role  "Findings specialist, sop compliance audit"
    goal  "Write audit findings from {findings} with compliance {level}"
}

flow main(sop: text) {
    parts    = Steps(sop)
    findings = par for part in parts { Auditor(part, sop) }
    level    = Compliance(findings)
    report   = Findings(findings, level)
    emit report, level
}
