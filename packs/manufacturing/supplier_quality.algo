// Manufacturing · Supplier quality review
// Supplier quality scorecards
// AlgoLang domain pack manufacturing.supplier_quality · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent Metrics(supplier_data: text) -> text {
    role  "Metrics specialist, supplier quality review"
    goal  "Summarise defect and delivery metrics in {supplier_data}"
}

agent Trends(draft: text) -> text {
    role  "Trends specialist, supplier quality review"
    goal  "Identify trends in {draft}"
}

agent Rating(work: text) -> score {
    role  "Rating specialist, supplier quality review"
    goal  "Score supplier quality 0 to 1 from {work}"
    policy {
        require human when confidence < 0.80
    }
}

agent Scorecard(work: text, level: score) -> text {
    role  "Scorecard specialist, supplier quality review"
    goal  "Write a supplier scorecard from {work} with rating {level}"
}

flow main(supplier_data: text) {
    first  = Metrics(supplier_data)
    work   = Trends(first)
    level  = Rating(work)
    report = Scorecard(work, level)
    emit report, level
}
