// Manufacturing · Quality inspection report
// Classify defects and recommend batch disposition
// AlgoLang domain pack manufacturing.quality_inspection · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 4000
    retry 1
}

agent Defects(inspection: text) -> text {
    role  "Defects specialist, quality inspection report"
    goal  "List defects recorded in {inspection}"
    uses  file.read
}

agent Classifier(draft: text) -> text {
    role  "Classifier specialist, quality inspection report"
    goal  "Classify severity and likely cause of {draft}"
}

agent Quality(work: text) -> score {
    role  "Quality specialist, quality inspection report"
    goal  "Score batch quality 0 to 1 from {work}"
    policy {
        require human when confidence < 0.80
    }
}

agent Disposition(work: text, level: score) -> text {
    role  "Disposition specialist, quality inspection report"
    goal  "Recommend a batch disposition for {work} with quality {level}"
}

flow main(inspection: text) {
    first  = Defects(inspection)
    work   = Classifier(first)
    level  = Quality(work)
    report = Disposition(work, level)
    emit report, level
}
