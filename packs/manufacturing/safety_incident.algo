// Manufacturing · Safety incident report
// Safety incident investigation reports
// AlgoLang domain pack manufacturing.safety_incident · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Facts(incident: text) -> text {
    role  "Facts specialist, safety incident report"
    goal  "Extract who, what, where and when from {incident}"
}

agent Hazards(draft: text) -> text {
    role  "Hazards specialist, safety incident report"
    goal  "Identify hazards and contributing factors in {draft}"
}

agent Severity(work: text) -> score {
    role  "Severity specialist, safety incident report"
    goal  "Score severity 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Actions(work: text, level: score) -> text {
    role  "Actions specialist, safety incident report"
    goal  "Write corrective actions for {work} with severity {level}"
}

flow main(incident: text) {
    first  = Facts(incident)
    work   = Hazards(first)
    level  = Severity(work)
    report = Actions(work, level)
    emit report, level
}
