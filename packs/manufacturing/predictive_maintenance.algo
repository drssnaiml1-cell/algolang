// Manufacturing · Predictive maintenance
// Prioritise maintenance from sensor summaries
// AlgoLang domain pack manufacturing.predictive_maintenance · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 4000
    retry 1
}

agent Assets(sensor_summary: text) -> list {
    role  "Assets specialist, predictive maintenance"
    goal  "List the assets in {sensor_summary}"
    uses  calc.eval
    model fast
}

agent Engineer(part: text, sensor_summary: text) -> text {
    role  "Engineer specialist, predictive maintenance"
    goal  "Assess failure risk for {part}"
}

agent Urgency(findings: list) -> score {
    role  "Urgency specialist, predictive maintenance"
    goal  "Score maintenance urgency 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.80
    }
}

agent WorkOrders(findings: list, level: score) -> text {
    role  "Work orders specialist, predictive maintenance"
    goal  "Draft prioritised work orders from {findings} with urgency {level}"
}

flow main(sensor_summary: text) {
    parts    = Assets(sensor_summary)
    findings = par for part in parts { Engineer(part, sensor_summary) }
    level    = Urgency(findings)
    report   = WorkOrders(findings, level)
    emit report, level
}
