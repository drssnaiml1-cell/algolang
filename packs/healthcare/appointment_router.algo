// Healthcare · Patient appointment router
// Route patient requests to urgent or routine booking
// AlgoLang domain pack healthcare.appointment_router · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent UrgencyCheck(request: text) -> score {
    role  "Urgency check specialist, patient appointment router"
    goal  "Score 0 to 1 how urgent this patient request is: {request}"
    model fast
}

agent UrgentDesk(request: text) -> text {
    role  "Urgent desk specialist, patient appointment router"
    goal  "Arrange a same-day slot and safety advice for: {request}"
}

agent RoutineDesk(request: text) -> text {
    role  "Routine desk specialist, patient appointment router"
    goal  "Offer the next routine appointment and preparation steps for: {request}"
}

agent ToneCheck(reply: text) -> score {
    role  "Tone check specialist, patient appointment router"
    goal  "Score 0 to 1 how clear and kind this reply is: {reply}"
    policy {
        require human when confidence < 0.80
    }
}

flow main(request: text) {
    if UrgencyCheck(request) >= 0.5 {
        reply = UrgentDesk(request)
    } else {
        reply = RoutineDesk(request)
    }
    quality = ToneCheck(reply)
    if quality < 0.7 {
        reply = UrgentDesk(request)
    }
    emit reply, quality
}
