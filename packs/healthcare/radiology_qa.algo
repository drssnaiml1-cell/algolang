// Healthcare · Radiology report quality check
// Check radiology reports for consistency and completeness
// AlgoLang domain pack healthcare.radiology_qa · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Parser(report: text) -> text {
    role  "Parser specialist, radiology report quality check"
    goal  "List the findings and impressions in {report}"
}

agent Consistency(draft: text) -> text {
    role  "Consistency specialist, radiology report quality check"
    goal  "Check whether impressions in {draft} follow from the findings"
}

agent QualityScorer(work: text) -> score {
    role  "Quality scorer specialist, radiology report quality check"
    goal  "Score report quality 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
    }
}

agent Feedback(work: text, level: score) -> text {
    role  "Feedback specialist, radiology report quality check"
    goal  "Write feedback for the radiologist on {work} with quality {level}"
}

flow main(report: text) {
    first  = Parser(report)
    work   = Consistency(first)
    level  = QualityScorer(work)
    report = Feedback(work, level)
    emit report, level
}
