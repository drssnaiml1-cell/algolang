// Healthcare · Drug interaction review
// Multi-expert review of prescription interactions
// AlgoLang domain pack healthcare.drug_interaction · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Pharmacologist(prescription: text) -> text {
    role  "Pharmacologist specialist, drug interaction review"
    goal  "Identify drug-drug interactions in {prescription}"
    uses  kb.search
}

agent Clinician(prescription: text) -> text {
    role  "Clinician specialist, drug interaction review"
    goal  "Assess clinical relevance of interactions in {prescription}"
}

agent SafetyOfficer(prescription: text) -> text {
    role  "Safety officer specialist, drug interaction review"
    goal  "List contraindications and monitoring needs for {prescription}"
}

agent RiskJudge(views: list) -> score {
    role  "Risk judge specialist, drug interaction review"
    goal  "Score overall interaction risk 0 to 1 from {views}"
    policy {
        require human when confidence < 0.90
    }
}

agent Advisor(views: list, verdict: score) -> text {
    role  "Advisor specialist, drug interaction review"
    goal  "Write prescriber advice from {views} with risk {verdict}"
}

flow main(prescription: text) {
    views   = par { Pharmacologist(prescription), Clinician(prescription), SafetyOfficer(prescription) }
    verdict = RiskJudge(views)
    report  = Advisor(views, verdict)
    emit report, verdict
}
