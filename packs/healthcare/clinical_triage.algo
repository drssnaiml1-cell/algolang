// Healthcare · Clinical note triage
// Summarise clinical notes, score urgency and draft referrals for doctor review
// AlgoLang domain pack healthcare.clinical_triage · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Extractor(note: text) -> text {
    role  "Extractor specialist, clinical note triage"
    goal  "Extract symptoms, history and medications from {note}"
    uses  kb.search
}

agent Summariser(draft: text) -> text {
    role  "Summariser specialist, clinical note triage"
    goal  "Write a structured clinical summary of {draft}"
}

agent UrgencyScorer(work: text) -> score {
    role  "Urgency scorer specialist, clinical note triage"
    goal  "Score clinical urgency from 0 to 1 for {work}"
    policy {
        require human when confidence < 0.90
        forbid caste, religion
    }
}

agent Referral(work: text, level: score) -> text {
    role  "Referral specialist, clinical note triage"
    goal  "Draft a referral note for the doctor from {work} with urgency {level}"
}

flow main(note: text) {
    first  = Extractor(note)
    work   = Summariser(first)
    level  = UrgencyScorer(work)
    report = Referral(work, level)
    emit report, level
}
