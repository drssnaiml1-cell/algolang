// Healthcare · Patient feedback analysis
// Find themes in patient feedback and suggest improvements
// AlgoLang domain pack healthcare.patient_feedback · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 3000
    retry 1
}

agent Splitter(feedback: text) -> list {
    role  "Splitter specialist, patient feedback analysis"
    goal  "Split {feedback} into individual patient comments"
    model fast
}

agent Analyst(part: text, feedback: text) -> text {
    role  "Analyst specialist, patient feedback analysis"
    goal  "Classify the theme and sentiment of {part} given the batch {feedback}"
}

agent Satisfaction(findings: list) -> score {
    role  "Satisfaction specialist, patient feedback analysis"
    goal  "Score overall patient satisfaction 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Reporter(findings: list, level: score) -> text {
    role  "Reporter specialist, patient feedback analysis"
    goal  "Write an improvement report from {findings} with satisfaction {level}"
}

flow main(feedback: text) {
    parts    = Splitter(feedback)
    findings = par for part in parts { Analyst(part, feedback) }
    level    = Satisfaction(findings)
    report   = Reporter(findings, level)
    emit report, level
}
