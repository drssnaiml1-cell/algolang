// Healthcare · Discharge summary drafting
// Draft discharge summaries for clinician sign-off
// AlgoLang domain pack healthcare.discharge_summary · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 6000
    retry 1
}

agent Collector(record: text) -> text {
    role  "Collector specialist, discharge summary drafting"
    goal  "Collect diagnoses, procedures and medications from {record}"
    uses  file.read
}

agent Writer(draft: text) -> text {
    role  "Writer specialist, discharge summary drafting"
    goal  "Draft a patient-friendly discharge summary from {draft}"
}

agent Checker(work: text) -> score {
    role  "Checker specialist, discharge summary drafting"
    goal  "Score 0 to 1 how complete and accurate the summary is: {work}"
    policy {
        require human when confidence < 0.90
        forbid caste, religion
    }
}

agent Finaliser(work: text, level: score) -> text {
    role  "Finaliser specialist, discharge summary drafting"
    goal  "Finalise the discharge summary {work} noting completeness {level}"
}

flow main(record: text) {
    first  = Collector(record)
    work   = Writer(first)
    level  = Checker(work)
    report = Finaliser(work, level)
    emit report, level
}
