// Legal & Compliance · Regulatory change impact
// Track regulatory changes and their impact
// AlgoLang domain pack legal.regulatory_change · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 4000
    retry 1
}

agent Changes(regulation: text) -> text {
    role  "Changes specialist, regulatory change impact"
    goal  "Summarise what changed in {regulation}"
    uses  web.search
}

agent Impact(draft: text) -> text {
    role  "Impact specialist, regulatory change impact"
    goal  "Identify business processes affected by {draft}"
}

agent Urgency(work: text) -> score {
    role  "Urgency specialist, regulatory change impact"
    goal  "Score implementation urgency 0 to 1 from {work}"
    policy {
        require human when confidence < 0.80
    }
}

agent Actions(work: text, level: score) -> text {
    role  "Actions specialist, regulatory change impact"
    goal  "Write an action plan for {work} with urgency {level}"
}

flow main(regulation: text) {
    first  = Changes(regulation)
    work   = Impact(first)
    level  = Urgency(work)
    report = Actions(work, level)
    emit report, level
}
