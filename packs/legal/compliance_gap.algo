// Legal & Compliance · Compliance gap analysis
// Find compliance gaps against regulations
// AlgoLang domain pack legal.compliance_gap · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Obligations(process: text) -> list {
    role  "Obligations specialist, compliance gap analysis"
    goal  "List regulatory obligations relevant to {process}"
    uses  kb.search
    model fast
}

agent Auditor(part: text, process: text) -> text {
    role  "Auditor specialist, compliance gap analysis"
    goal  "Check whether {part} is met by the process {process}"
}

agent Compliance(findings: list) -> score {
    role  "Compliance specialist, compliance gap analysis"
    goal  "Score compliance 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
    }
}

agent Plan(findings: list, level: score) -> text {
    role  "Plan specialist, compliance gap analysis"
    goal  "Write a remediation plan from {findings} with compliance {level}"
}

flow main(process: text) {
    parts    = Obligations(process)
    findings = par for part in parts { Auditor(part, process) }
    level    = Compliance(findings)
    report   = Plan(findings, level)
    emit report, level
}
