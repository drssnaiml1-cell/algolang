// Legal & Compliance · Case law research
// Research precedents for legal issues
// AlgoLang domain pack legal.case_research · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 4000
    retry 1
}

agent Questions(issue: text) -> list {
    role  "Questions specialist, case law research"
    goal  "Break {issue} into legal questions"
    uses  web.search
    model fast
}

agent Researcher(part: text, issue: text) -> text {
    role  "Researcher specialist, case law research"
    goal  "Find relevant precedents for {part}"
}

agent Strength(findings: list) -> score {
    role  "Strength specialist, case law research"
    goal  "Score strength of the legal position 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.80
    }
}

agent Memo(findings: list, level: score) -> text {
    role  "Memo specialist, case law research"
    goal  "Write a research memo from {findings} with strength {level}"
}

flow main(issue: text) {
    parts    = Questions(issue)
    findings = par for part in parts { Researcher(part, issue) }
    level    = Strength(findings)
    report   = Memo(findings, level)
    emit report, level
}
