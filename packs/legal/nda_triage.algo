// Legal & Compliance · NDA triage
// Triage NDAs against the legal playbook
// AlgoLang domain pack legal.nda_triage · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 4000
    retry 1
}

agent Terms(nda: text) -> text {
    role  "Terms specialist, nda triage"
    goal  "Extract key terms from {nda}"
    uses  kb.search
}

agent Playbook(draft: text) -> text {
    role  "Playbook specialist, nda triage"
    goal  "Compare {draft} with the company playbook"
}

agent Deviation(work: text) -> score {
    role  "Deviation specialist, nda triage"
    goal  "Score deviation from playbook 0 to 1 from {work}"
    policy {
        require human when confidence < 0.80
    }
}

agent Redlines(work: text, level: score) -> text {
    role  "Redlines specialist, nda triage"
    goal  "Suggest redlines for {work} with deviation {level}"
}

flow main(nda: text) {
    first  = Terms(nda)
    work   = Playbook(first)
    level  = Deviation(work)
    report = Redlines(work, level)
    emit report, level
}
