// Legal & Compliance · Litigation risk assessment
// Assess disputes and settlement options
// AlgoLang domain pack legal.litigation_risk · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Counsel(dispute: text) -> text {
    role  "Counsel specialist, litigation risk assessment"
    goal  "Assess merits of {dispute}"
}

agent Economist(dispute: text) -> text {
    role  "Economist specialist, litigation risk assessment"
    goal  "Estimate exposure and costs in {dispute}"
}

agent Strategist(dispute: text) -> text {
    role  "Strategist specialist, litigation risk assessment"
    goal  "Assess settlement options for {dispute}"
}

agent Panel(views: list) -> score {
    role  "Panel specialist, litigation risk assessment"
    goal  "Score litigation risk 0 to 1 from {views}"
    policy {
        require human when confidence < 0.90
    }
}

agent Memo(views: list, verdict: score) -> text {
    role  "Memo specialist, litigation risk assessment"
    goal  "Write a litigation strategy memo from {views} with risk {verdict}"
}

flow main(dispute: text) {
    views   = par { Counsel(dispute), Economist(dispute), Strategist(dispute) }
    verdict = Panel(views)
    report  = Memo(views, verdict)
    emit report, verdict
}
