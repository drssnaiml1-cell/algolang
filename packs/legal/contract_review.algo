// Legal & Compliance · Contract clause review
// Clause-by-clause contract risk review
// AlgoLang domain pack legal.contract_review · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 6000
    retry 1
}

agent Clauses(contract: text) -> list {
    role  "Clauses specialist, contract clause review"
    goal  "List every clause in {contract}"
    uses  file.read
    model fast
}

agent Analyst(part: text, contract: text) -> text {
    role  "Analyst specialist, contract clause review"
    goal  "Flag risks and missing protections in {part}"
}

agent Risk(findings: list) -> score {
    role  "Risk specialist, contract clause review"
    goal  "Score overall contract risk 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
    }
}

agent Summary(findings: list, level: score) -> text {
    role  "Summary specialist, contract clause review"
    goal  "Write a contract risk summary from {findings} with risk {level}"
}

flow main(contract: text) {
    parts    = Clauses(contract)
    findings = par for part in parts { Analyst(part, contract) }
    level    = Risk(findings)
    report   = Summary(findings, level)
    emit report, level
}
