// Telecom & IT Operations · Capacity planning
// Forecast infrastructure capacity
// AlgoLang domain pack itops.capacity_planning · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 4000
    retry 1
}

agent Trends(usage_report: text) -> text {
    role  "Trends specialist, capacity planning"
    goal  "Describe growth trends in {usage_report}"
    uses  calc.eval
}

agent Forecast(draft: text) -> text {
    role  "Forecast specialist, capacity planning"
    goal  "Forecast capacity needs from {draft}"
}

agent Risk(work: text) -> score {
    role  "Risk specialist, capacity planning"
    goal  "Score capacity risk 0 to 1 from {work}"
    policy {
        require human when confidence < 0.80
    }
}

agent Plan(work: text, level: score) -> text {
    role  "Plan specialist, capacity planning"
    goal  "Write a capacity plan from {work} with risk {level}"
}

flow main(usage_report: text) {
    first  = Trends(usage_report)
    work   = Forecast(first)
    level  = Risk(work)
    report = Plan(work, level)
    emit report, level
}
