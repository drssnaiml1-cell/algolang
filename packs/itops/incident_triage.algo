// Telecom & IT Operations · IT incident triage
// Classify incidents and suggest first response
// AlgoLang domain pack itops.incident_triage · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Classifier(incident: text) -> text {
    role  "Classifier specialist, it incident triage"
    goal  "Classify service, impact and urgency of {incident}"
    uses  kb.search
}

agent Diagnosis(draft: text) -> text {
    role  "Diagnosis specialist, it incident triage"
    goal  "Suggest likely causes and checks for {draft}"
}

agent Priority(work: text) -> score {
    role  "Priority specialist, it incident triage"
    goal  "Score incident priority 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
    }
}

agent Runbook(work: text, level: score) -> text {
    role  "Runbook specialist, it incident triage"
    goal  "Write first-response steps for {work} with priority {level}"
}

flow main(incident: text) {
    first  = Classifier(incident)
    work   = Diagnosis(first)
    level  = Priority(work)
    report = Runbook(work, level)
    emit report, level
}
