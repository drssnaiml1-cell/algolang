// Telecom & IT Operations · Incident postmortem writer
// Blameless incident postmortems
// AlgoLang domain pack itops.postmortem · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 3000
    retry 1
}

agent Phases(timeline: text) -> list {
    role  "Phases specialist, incident postmortem writer"
    goal  "Split {timeline} into detection, response and recovery phases"
    model fast
}

agent Analyst(part: text, timeline: text) -> text {
    role  "Analyst specialist, incident postmortem writer"
    goal  "Find what went well and what to improve in {part}"
}

agent Learning(findings: list) -> score {
    role  "Learning specialist, incident postmortem writer"
    goal  "Score learning value 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Postmortem(findings: list, level: score) -> text {
    role  "Postmortem specialist, incident postmortem writer"
    goal  "Write a blameless postmortem from {findings} with score {level}"
}

flow main(timeline: text) {
    parts    = Phases(timeline)
    findings = par for part in parts { Analyst(part, timeline) }
    level    = Learning(findings)
    report   = Postmortem(findings, level)
    emit report, level
}
