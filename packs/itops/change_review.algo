// Telecom & IT Operations · Change risk review
// Change advisory board review
// AlgoLang domain pack itops.change_review · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Architect(change_request: text) -> text {
    role  "Architect specialist, change risk review"
    goal  "Assess technical risk of {change_request}"
}

agent Operations(change_request: text) -> text {
    role  "Operations specialist, change risk review"
    goal  "Assess operational and rollback risk of {change_request}"
}

agent Security(change_request: text) -> text {
    role  "Security specialist, change risk review"
    goal  "Assess security impact of {change_request}"
}

agent CAB(views: list) -> score {
    role  "C a b specialist, change risk review"
    goal  "Score change approval 0 to 1 from {views}"
    policy {
        require human when confidence < 0.90
    }
}

agent Decision(views: list, verdict: score) -> text {
    role  "Decision specialist, change risk review"
    goal  "Write the CAB decision from {views} with score {verdict}"
}

flow main(change_request: text) {
    views   = par { Architect(change_request), Operations(change_request), Security(change_request) }
    verdict = CAB(views)
    report  = Decision(views, verdict)
    emit report, verdict
}
