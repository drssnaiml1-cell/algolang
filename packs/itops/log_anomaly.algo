// Telecom & IT Operations · Log anomaly detection
// Find anomalies in system logs
// AlgoLang domain pack itops.log_anomaly · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 4000
    retry 1
}

agent Windows(logs: text) -> list {
    role  "Windows specialist, log anomaly detection"
    goal  "Split {logs} into time windows"
    uses  file.read
    model fast
}

agent Detector(part: text, logs: text) -> text {
    role  "Detector specialist, log anomaly detection"
    goal  "Find anomalies and error bursts in {part}"
}

agent Severity(findings: list) -> score {
    role  "Severity specialist, log anomaly detection"
    goal  "Score overall severity 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.80
    }
}

agent Report(findings: list, level: score) -> text {
    role  "Report specialist, log anomaly detection"
    goal  "Write an anomaly report from {findings} with severity {level}"
}

flow main(logs: text) {
    parts    = Windows(logs)
    findings = par for part in parts { Detector(part, logs) }
    level    = Severity(findings)
    report   = Report(findings, level)
    emit report, level
}
