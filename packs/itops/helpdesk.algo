// Telecom & IT Operations · IT helpdesk router
// Route helpdesk tickets
// AlgoLang domain pack itops.helpdesk · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 3000
    retry 1
}

agent IsAccess(ticket: text) -> score {
    role  "Is access specialist, it helpdesk router"
    goal  "Score 0 to 1 how likely this ticket is about access or accounts: {ticket}"
    model fast
}

agent AccessDesk(ticket: text) -> text {
    role  "Access desk specialist, it helpdesk router"
    goal  "Resolve this access or password issue: {ticket}"
    uses  kb.search
}

agent ServiceDesk(ticket: text) -> text {
    role  "Service desk specialist, it helpdesk router"
    goal  "Resolve this hardware or software issue: {ticket}"
    uses  kb.search
}

agent Clarity(reply: text) -> score {
    role  "Clarity specialist, it helpdesk router"
    goal  "Score 0 to 1 how clear these steps are: {reply}"
    policy {
        require human when confidence < 0.70
    }
}

flow main(ticket: text) {
    if IsAccess(ticket) >= 0.5 {
        reply = AccessDesk(ticket)
    } else {
        reply = ServiceDesk(ticket)
    }
    quality = Clarity(reply)
    if quality < 0.7 {
        reply = AccessDesk(ticket)
    }
    emit reply, quality
}
