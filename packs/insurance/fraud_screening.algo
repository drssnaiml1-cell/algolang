// Insurance · Claims fraud screening
// Panel review of claims for fraud indicators
// AlgoLang domain pack insurance.fraud_screening · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent PatternAnalyst(claim: text) -> text {
    role  "Pattern analyst specialist, claims fraud screening"
    goal  "Look for known fraud patterns in {claim}"
}

agent DocumentExaminer(claim: text) -> text {
    role  "Document examiner specialist, claims fraud screening"
    goal  "Check documents in {claim} for inconsistencies"
}

agent Adjuster(claim: text) -> text {
    role  "Adjuster specialist, claims fraud screening"
    goal  "Assess plausibility of the loss in {claim}"
}

agent FraudPanel(views: list) -> score {
    role  "Fraud panel specialist, claims fraud screening"
    goal  "Score fraud likelihood 0 to 1 from {views}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Referral(views: list, verdict: score) -> text {
    role  "Referral specialist, claims fraud screening"
    goal  "Write an SIU referral note from {views} with likelihood {verdict}"
}

flow main(claim: text) {
    views   = par { PatternAnalyst(claim), DocumentExaminer(claim), Adjuster(claim) }
    verdict = FraudPanel(views)
    report  = Referral(views, verdict)
    emit report, verdict
}
