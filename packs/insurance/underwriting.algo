// Insurance · Underwriting risk assessment
// Assess proposals and suggest underwriting terms
// AlgoLang domain pack insurance.underwriting · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 6000
    retry 1
}

agent Profile(proposal: text) -> text {
    role  "Profile specialist, underwriting risk assessment"
    goal  "Extract risk factors from {proposal}"
    uses  calc.eval
}

agent Assessor(draft: text) -> text {
    role  "Assessor specialist, underwriting risk assessment"
    goal  "Assess each risk factor in {draft}"
}

agent RiskScore(work: text) -> score {
    role  "Risk score specialist, underwriting risk assessment"
    goal  "Score insurable risk 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Terms(work: text, level: score) -> text {
    role  "Terms specialist, underwriting risk assessment"
    goal  "Propose underwriting terms for {work} with risk {level}"
}

flow main(proposal: text) {
    first  = Profile(proposal)
    work   = Assessor(first)
    level  = RiskScore(work)
    report = Terms(work, level)
    emit report, level
}
