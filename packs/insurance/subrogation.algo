// Insurance · Subrogation opportunity finder
// Find recovery opportunities in closed claims
// AlgoLang domain pack insurance.subrogation · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent Splitter(claims: text) -> list {
    role  "Splitter specialist, subrogation opportunity finder"
    goal  "Split {claims} into individual closed claims"
    model fast
}

agent Reviewer(part: text, claims: text) -> text {
    role  "Reviewer specialist, subrogation opportunity finder"
    goal  "Identify third-party liability in {part}"
}

agent Recovery(findings: list) -> score {
    role  "Recovery specialist, subrogation opportunity finder"
    goal  "Score overall recovery potential 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.80
    }
}

agent Report(findings: list, level: score) -> text {
    role  "Report specialist, subrogation opportunity finder"
    goal  "List subrogation opportunities from {findings} with potential {level}"
}

flow main(claims: text) {
    parts    = Splitter(claims)
    findings = par for part in parts { Reviewer(part, claims) }
    level    = Recovery(findings)
    report   = Report(findings, level)
    emit report, level
}
