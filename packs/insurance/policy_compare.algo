// Insurance · Policy comparison
// Compare insurance policies for a customer
// AlgoLang domain pack insurance.policy_compare · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 3000
    retry 1
}

agent Policies(policies: text) -> list {
    role  "Policies specialist, policy comparison"
    goal  "List the policies described in {policies}"
    uses  file.read
    model fast
}

agent Analyst(part: text, policies: text) -> text {
    role  "Analyst specialist, policy comparison"
    goal  "Summarise cover, exclusions and limits of {part}"
}

agent BestFit(findings: list) -> score {
    role  "Best fit specialist, policy comparison"
    goal  "Score 0 to 1 how well the best option fits the need in {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Advice(findings: list, level: score) -> text {
    role  "Advice specialist, policy comparison"
    goal  "Write a plain-language comparison from {findings} with fit {level}"
}

flow main(policies: text) {
    parts    = Policies(policies)
    findings = par for part in parts { Analyst(part, policies) }
    level    = BestFit(findings)
    report   = Advice(findings, level)
    emit report, level
}
