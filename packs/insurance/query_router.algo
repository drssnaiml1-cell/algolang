// Insurance · Policyholder query router
// Route policyholder questions to the right desk
// AlgoLang domain pack insurance.query_router · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 3000
    retry 1
}

agent IsClaim(query: text) -> score {
    role  "Is claim specialist, policyholder query router"
    goal  "Score 0 to 1 how likely this query is about a claim: {query}"
    model fast
}

agent ClaimsDesk(query: text) -> text {
    role  "Claims desk specialist, policyholder query router"
    goal  "Answer this claims query with next steps: {query}"
    uses  kb.search
}

agent PolicyDesk(query: text) -> text {
    role  "Policy desk specialist, policyholder query router"
    goal  "Answer this policy or billing query: {query}"
    uses  kb.search
}

agent Clarity(reply: text) -> score {
    role  "Clarity specialist, policyholder query router"
    goal  "Score 0 to 1 how clear this reply is: {reply}"
    policy {
        require human when confidence < 0.70
    }
}

flow main(query: text) {
    if IsClaim(query) >= 0.5 {
        reply = ClaimsDesk(query)
    } else {
        reply = PolicyDesk(query)
    }
    quality = Clarity(reply)
    if quality < 0.7 {
        reply = ClaimsDesk(query)
    }
    emit reply, quality
}
