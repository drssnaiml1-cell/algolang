// Insurance · Claims triage
// Triage new insurance claims and check coverage
// AlgoLang domain pack insurance.claims_triage · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Intake(claim: text) -> text {
    role  "Intake specialist, claims triage"
    goal  "Extract policy, incident and loss details from {claim}"
    uses  kb.search
}

agent Coverage(draft: text) -> text {
    role  "Coverage specialist, claims triage"
    goal  "Check coverage for {draft} against policy terms"
}

agent Complexity(work: text) -> score {
    role  "Complexity specialist, claims triage"
    goal  "Score claim complexity 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Routing(work: text, level: score) -> text {
    role  "Routing specialist, claims triage"
    goal  "Recommend a handling route for {work} with complexity {level}"
}

flow main(claim: text) {
    first  = Intake(claim)
    work   = Coverage(first)
    level  = Complexity(work)
    report = Routing(work, level)
    emit report, level
}
