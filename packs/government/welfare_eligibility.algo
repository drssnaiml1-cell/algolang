// Government & Public Services · Welfare scheme eligibility
// Check scheme eligibility for officer approval
// AlgoLang domain pack government.welfare_eligibility · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Extractor(application: text) -> text {
    role  "Extractor specialist, welfare scheme eligibility"
    goal  "Extract household and income details from {application}"
    uses  kb.search
}

agent Rules(draft: text) -> text {
    role  "Rules specialist, welfare scheme eligibility"
    goal  "Check {draft} against scheme eligibility rules"
}

agent Eligibility(work: text) -> score {
    role  "Eligibility specialist, welfare scheme eligibility"
    goal  "Score eligibility 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Notice(work: text, level: score) -> text {
    role  "Notice specialist, welfare scheme eligibility"
    goal  "Draft an eligibility notice from {work} with score {level}"
}

flow main(application: text) {
    first  = Extractor(application)
    work   = Rules(first)
    level  = Eligibility(work)
    report = Notice(work, level)
    emit report, level
}
