// Government & Public Services · Tender evaluation
// Transparent tender evaluation committees
// AlgoLang domain pack government.tender_evaluation · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 6000
    retry 1
}

agent TechnicalEvaluator(bids: text) -> text {
    role  "Technical evaluator specialist, tender evaluation"
    goal  "Evaluate technical compliance of {bids}"
    uses  calc.eval
}

agent FinancialEvaluator(bids: text) -> text {
    role  "Financial evaluator specialist, tender evaluation"
    goal  "Evaluate prices and value in {bids}"
}

agent IntegrityChecker(bids: text) -> text {
    role  "Integrity checker specialist, tender evaluation"
    goal  "Check {bids} for conflicts of interest and collusion signs"
}

agent Committee(views: list) -> score {
    role  "Committee specialist, tender evaluation"
    goal  "Score the recommended bid 0 to 1 from {views}"
    policy {
        require human when confidence < 0.90
    }
}

agent Minutes(views: list, verdict: score) -> text {
    role  "Minutes specialist, tender evaluation"
    goal  "Write evaluation minutes from {views} with score {verdict}"
}

flow main(bids: text) {
    views   = par { TechnicalEvaluator(bids), FinancialEvaluator(bids), IntegrityChecker(bids) }
    verdict = Committee(views)
    report  = Minutes(views, verdict)
    emit report, verdict
}
