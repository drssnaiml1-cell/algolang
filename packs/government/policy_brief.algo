// Government & Public Services · Policy impact brief
// Multi-perspective policy impact briefs
// AlgoLang domain pack government.policy_brief · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 4000
    retry 1
}

agent Economist(policy: text) -> text {
    role  "Economist specialist, policy impact brief"
    goal  "Assess economic impact of {policy}"
    uses  web.search
}

agent SocialAnalyst(policy: text) -> text {
    role  "Social analyst specialist, policy impact brief"
    goal  "Assess social and equity impact of {policy}"
}

agent LegalAnalyst(policy: text) -> text {
    role  "Legal analyst specialist, policy impact brief"
    goal  "Assess legal and implementation issues in {policy}"
}

agent Panel(views: list) -> score {
    role  "Panel specialist, policy impact brief"
    goal  "Score expected net benefit 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
    }
}

agent Brief(views: list, verdict: score) -> text {
    role  "Brief specialist, policy impact brief"
    goal  "Write a policy brief from {views} with score {verdict}"
}

flow main(policy: text) {
    views   = par { Economist(policy), SocialAnalyst(policy), LegalAnalyst(policy) }
    verdict = Panel(views)
    report  = Brief(views, verdict)
    emit report, verdict
}
