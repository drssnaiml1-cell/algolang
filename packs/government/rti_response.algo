// Government & Public Services · RTI response drafting
// Draft Right-to-Information replies
// AlgoLang domain pack government.rti_response · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 4000
    retry 1
}

agent Parser(request: text) -> text {
    role  "Parser specialist, rti response drafting"
    goal  "List the information sought in {request}"
    uses  file.read
}

agent Locator(draft: text) -> text {
    role  "Locator specialist, rti response drafting"
    goal  "Identify records that answer {draft}"
}

agent Exemptions(work: text) -> score {
    role  "Exemptions specialist, rti response drafting"
    goal  "Score 0 to 1 how much of {work} can be disclosed"
    policy {
        require human when confidence < 0.80
    }
}

agent Response(work: text, level: score) -> text {
    role  "Response specialist, rti response drafting"
    goal  "Draft an RTI reply from {work} with disclosure {level}"
}

flow main(request: text) {
    first  = Parser(request)
    work   = Locator(first)
    level  = Exemptions(work)
    report = Response(work, level)
    emit report, level
}
