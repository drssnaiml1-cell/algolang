// Government & Public Services · Public consultation analysis
// Summarise public consultation responses
// AlgoLang domain pack government.public_consultation · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 3000
    retry 1
}

agent Splitter(submissions: text) -> list {
    role  "Splitter specialist, public consultation analysis"
    goal  "Split {submissions} into individual submissions"
    model fast
}

agent Analyst(part: text, submissions: text) -> text {
    role  "Analyst specialist, public consultation analysis"
    goal  "Summarise the position and reasons in {part}"
}

agent Support(findings: list) -> score {
    role  "Support specialist, public consultation analysis"
    goal  "Score overall public support 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Report(findings: list, level: score) -> text {
    role  "Report specialist, public consultation analysis"
    goal  "Write a consultation report from {findings} with support {level}"
}

flow main(submissions: text) {
    parts    = Splitter(submissions)
    findings = par for part in parts { Analyst(part, submissions) }
    level    = Support(findings)
    report   = Report(findings, level)
    emit report, level
}
