// Government & Public Services · Citizen grievance routing
// Route citizen grievances to the right department
// AlgoLang domain pack government.grievance_routing · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 4000
    retry 1
}

agent Urgency(grievance: text) -> score {
    role  "Urgency specialist, citizen grievance routing"
    goal  "Score 0 to 1 how urgent this grievance is: {grievance}"
    model fast
}

agent PriorityCell(grievance: text) -> text {
    role  "Priority cell specialist, citizen grievance routing"
    goal  "Assign to the priority cell with an action plan: {grievance}"
    uses  kb.search
}

agent Department(grievance: text) -> text {
    role  "Department specialist, citizen grievance routing"
    goal  "Route to the right department with a reply: {grievance}"
    uses  kb.search
}

agent Clarity(reply: text) -> score {
    role  "Clarity specialist, citizen grievance routing"
    goal  "Score 0 to 1 how clear this reply is: {reply}"
    policy {
        require human when confidence < 0.80
    }
}

flow main(grievance: text) {
    if Urgency(grievance) >= 0.5 {
        reply = PriorityCell(grievance)
    } else {
        reply = Department(grievance)
    }
    quality = Clarity(reply)
    if quality < 0.7 {
        reply = PriorityCell(grievance)
    }
    emit reply, quality
}
