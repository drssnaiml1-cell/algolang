// HR & Workforce · Employee query router
// Route employee questions to the right HR channel
// AlgoLang domain pack hr.employee_router · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 3000
    retry 1
}

agent IsSensitive(query: text) -> score {
    role  "Is sensitive specialist, employee query router"
    goal  "Score 0 to 1 how sensitive this employee query is: {query}"
    model fast
}

agent HRPartner(query: text) -> text {
    role  "H r partner specialist, employee query router"
    goal  "Draft a confidential HR partner reply for: {query}"
    uses  kb.search
}

agent HRDesk(query: text) -> text {
    role  "H r desk specialist, employee query router"
    goal  "Answer this HR policy query: {query}"
    uses  kb.search
}

agent Helpfulness(reply: text) -> score {
    role  "Helpfulness specialist, employee query router"
    goal  "Score 0 to 1 how helpful this reply is: {reply}"
    policy {
        require human when confidence < 0.70
    }
}

flow main(query: text) {
    if IsSensitive(query) >= 0.5 {
        reply = HRPartner(query)
    } else {
        reply = HRDesk(query)
    }
    quality = Helpfulness(reply)
    if quality < 0.7 {
        reply = HRPartner(query)
    }
    emit reply, quality
}
