// HR & Workforce · Exit interview analysis
// Find attrition drivers in exit interviews
// AlgoLang domain pack hr.exit_interviews · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 3000
    retry 1
}

agent Splitter(interviews: text) -> list {
    role  "Splitter specialist, exit interview analysis"
    goal  "Split {interviews} into individual exit interviews"
    model fast
}

agent Analyst(part: text, interviews: text) -> text {
    role  "Analyst specialist, exit interview analysis"
    goal  "Find reasons for leaving in {part}"
}

agent Attrition(findings: list) -> score {
    role  "Attrition specialist, exit interview analysis"
    goal  "Score attrition risk for remaining staff 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Report(findings: list, level: score) -> text {
    role  "Report specialist, exit interview analysis"
    goal  "Write a retention report from {findings} with risk {level}"
}

flow main(interviews: text) {
    parts    = Splitter(interviews)
    findings = par for part in parts { Analyst(part, interviews) }
    level    = Attrition(findings)
    report   = Report(findings, level)
    emit report, level
}
