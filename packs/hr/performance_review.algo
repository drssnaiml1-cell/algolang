// HR & Workforce · Performance review assistant
// Evidence-based performance review drafts
// AlgoLang domain pack hr.performance_review · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Evidence(review_notes: text) -> text {
    role  "Evidence specialist, performance review assistant"
    goal  "Organise evidence of achievements in {review_notes}"
}

agent Balance(draft: text) -> text {
    role  "Balance specialist, performance review assistant"
    goal  "Check {draft} for balanced, behaviour-based language"
}

agent Rating(work: text) -> score {
    role  "Rating specialist, performance review assistant"
    goal  "Score performance 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Draft(work: text, level: score) -> text {
    role  "Draft specialist, performance review assistant"
    goal  "Draft a review summary from {work} with rating {level}"
}

flow main(review_notes: text) {
    first  = Evidence(review_notes)
    work   = Balance(first)
    level  = Rating(work)
    report = Draft(work, level)
    emit report, level
}
