// HR & Workforce · Job description writer
// Write inclusive job descriptions
// AlgoLang domain pack hr.job_description · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 3000
    retry 1
}

agent Drafter(role_brief: text) -> text {
    role  "Drafter specialist, job description writer"
    goal  "Draft a job description from {role_brief}"
}

agent InclusiveEditor(draft: text) -> text {
    role  "Inclusive editor specialist, job description writer"
    goal  "Rewrite {draft} in inclusive, bias-free language"
}

agent Quality(work: text) -> score {
    role  "Quality specialist, job description writer"
    goal  "Score clarity and inclusiveness 0 to 1 of {work}"
    policy {
        require human when confidence < 0.70
    }
}

agent Final(work: text, level: score) -> text {
    role  "Final specialist, job description writer"
    goal  "Finalise the job description {work} with quality {level}"
}

flow main(role_brief: text) {
    first  = Drafter(role_brief)
    work   = InclusiveEditor(first)
    level  = Quality(work)
    report = Final(work, level)
    emit report, level
}
