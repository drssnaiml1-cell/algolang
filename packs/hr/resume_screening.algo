// HR & Workforce · Resume screening
// Fair, panel-style resume screening
// AlgoLang domain pack hr.resume_screening · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent SkillsReviewer(resume: text) -> text {
    role  "Skills reviewer specialist, resume screening"
    goal  "Assess skills against the job in {resume}"
}

agent ExperienceReviewer(resume: text) -> text {
    role  "Experience reviewer specialist, resume screening"
    goal  "Assess relevant experience in {resume}"
}

agent PotentialReviewer(resume: text) -> text {
    role  "Potential reviewer specialist, resume screening"
    goal  "Assess growth potential in {resume}"
}

agent HiringPanel(views: list) -> score {
    role  "Hiring panel specialist, resume screening"
    goal  "Score shortlist recommendation 0 to 1 from {views}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Note(views: list, verdict: score) -> text {
    role  "Note specialist, resume screening"
    goal  "Write a shortlist note from {views} with score {verdict}"
}

flow main(resume: text) {
    views   = par { SkillsReviewer(resume), ExperienceReviewer(resume), PotentialReviewer(resume) }
    verdict = HiringPanel(views)
    report  = Note(views, verdict)
    emit report, verdict
}
