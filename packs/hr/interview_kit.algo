// HR & Workforce · Interview kit builder
// Structured interview questions and rubrics
// AlgoLang domain pack hr.interview_kit · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 3000
    retry 1
}

agent Competencies(role: text) -> list {
    role  "Competencies specialist, interview kit builder"
    goal  "List the key competencies for {role}"
    model fast
}

agent QuestionWriter(part: text, role: text) -> text {
    role  "Question writer specialist, interview kit builder"
    goal  "Write 3 structured interview questions and a scoring rubric for {part}"
}

agent Coverage(findings: list) -> score {
    role  "Coverage specialist, interview kit builder"
    goal  "Score kit coverage 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Kit(findings: list, level: score) -> text {
    role  "Kit specialist, interview kit builder"
    goal  "Assemble an interview kit from {findings} with coverage {level}"
}

flow main(role: text) {
    parts    = Competencies(role)
    findings = par for part in parts { QuestionWriter(part, role) }
    level    = Coverage(findings)
    report   = Kit(findings, level)
    emit report, level
}
