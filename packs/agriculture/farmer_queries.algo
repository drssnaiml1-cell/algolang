// Agriculture · Farmer query router
// Route farmer queries to field officers or the helpline
// AlgoLang domain pack agriculture.farmer_queries · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 3000
    retry 1
}

agent IsUrgent(query: text) -> score {
    role  "Is urgent specialist, farmer query router"
    goal  "Score 0 to 1 how urgent this farmer query is: {query}"
    model fast
}

agent FieldOfficer(query: text) -> text {
    role  "Field officer specialist, farmer query router"
    goal  "Draft a field officer visit plan for: {query}"
    uses  kb.search
}

agent Helpline(query: text) -> text {
    role  "Helpline specialist, farmer query router"
    goal  "Answer this farming question simply: {query}"
    uses  kb.search
}

agent Clarity(reply: text) -> score {
    role  "Clarity specialist, farmer query router"
    goal  "Score 0 to 1 how simple and clear this answer is: {reply}"
    policy {
        require human when confidence < 0.70
    }
}

flow main(query: text) {
    if IsUrgent(query) >= 0.5 {
        reply = FieldOfficer(query)
    } else {
        reply = Helpline(query)
    }
    quality = Clarity(reply)
    if quality < 0.7 {
        reply = FieldOfficer(query)
    }
    emit reply, quality
}
