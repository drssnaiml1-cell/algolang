// Agriculture · Market price brief
// Market price trends for farmers
// AlgoLang domain pack agriculture.market_prices · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 3000
    retry 1
}

agent Markets(commodity: text) -> list {
    role  "Markets specialist, market price brief"
    goal  "List major markets for {commodity}"
    uses  web.search
    model fast
}

agent Analyst(part: text, commodity: text) -> text {
    role  "Analyst specialist, market price brief"
    goal  "Summarise price trend in {part}"
}

agent Outlook(findings: list) -> score {
    role  "Outlook specialist, market price brief"
    goal  "Score price outlook 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Brief(findings: list, level: score) -> text {
    role  "Brief specialist, market price brief"
    goal  "Write a selling advice brief from {findings} with outlook {level}"
}

flow main(commodity: text) {
    parts    = Markets(commodity)
    findings = par for part in parts { Analyst(part, commodity) }
    level    = Outlook(findings)
    report   = Brief(findings, level)
    emit report, level
}
