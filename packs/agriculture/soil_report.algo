// Agriculture · Soil report advisor
// Turn soil tests into fertiliser advice
// AlgoLang domain pack agriculture.soil_report · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 3000
    retry 1
}

agent Reader(soil_test: text) -> text {
    role  "Reader specialist, soil report advisor"
    goal  "Interpret nutrient levels in {soil_test}"
    uses  calc.eval
}

agent Plan(draft: text) -> text {
    role  "Plan specialist, soil report advisor"
    goal  "Recommend fertiliser doses from {draft}"
}

agent Confidence(work: text) -> score {
    role  "Confidence specialist, soil report advisor"
    goal  "Score recommendation confidence 0 to 1 for {work}"
    policy {
        require human when confidence < 0.70
    }
}

agent Card(work: text, level: score) -> text {
    role  "Card specialist, soil report advisor"
    goal  "Write a soil health card from {work} with confidence {level}"
}

flow main(soil_test: text) {
    first  = Reader(soil_test)
    work   = Plan(first)
    level  = Confidence(work)
    report = Card(work, level)
    emit report, level
}
