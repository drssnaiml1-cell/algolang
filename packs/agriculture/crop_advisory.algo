// Agriculture · Crop advisory
// Crop advice in local languages
// AlgoLang domain pack agriculture.crop_advisory · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 3000
    retry 1
}

agent Advisor(crop_and_region: text) -> text {
    role  "Advisor specialist, crop advisory"
    goal  "Give weather-aware sowing and care advice for {crop_and_region}"
    uses  web.search
}

agent Translator(draft: text) -> text {
    role  "Translator specialist, crop advisory"
    goal  "Translate {draft} into simple Hindi for farmers"
}

agent Safety(work: text) -> score {
    role  "Safety specialist, crop advisory"
    goal  "Score 0 to 1 how safe the pesticide guidance in {work} is"
    policy {
        require human when confidence < 0.70
    }
}

agent Final(work: text, level: score) -> text {
    role  "Final specialist, crop advisory"
    goal  "Finalise the advisory {work} with safety {level}"
}

flow main(crop_and_region: text) {
    first  = Advisor(crop_and_region)
    work   = Translator(first)
    level  = Safety(work)
    report = Final(work, level)
    emit report, level
}
