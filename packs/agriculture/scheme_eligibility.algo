// Agriculture · Farmer scheme eligibility
// Check farmer eligibility for government schemes
// AlgoLang domain pack agriculture.scheme_eligibility · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Extractor(farmer_profile: text) -> text {
    role  "Extractor specialist, farmer scheme eligibility"
    goal  "Extract land, crop and income details from {farmer_profile}"
    uses  kb.search
}

agent Rules(draft: text) -> text {
    role  "Rules specialist, farmer scheme eligibility"
    goal  "Check {draft} against scheme rules"
}

agent Eligibility(work: text) -> score {
    role  "Eligibility specialist, farmer scheme eligibility"
    goal  "Score eligibility 0 to 1 from {work}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Notice(work: text, level: score) -> text {
    role  "Notice specialist, farmer scheme eligibility"
    goal  "Draft an eligibility notice from {work} with score {level}"
}

flow main(farmer_profile: text) {
    first  = Extractor(farmer_profile)
    work   = Rules(first)
    level  = Eligibility(work)
    report = Notice(work, level)
    emit report, level
}
