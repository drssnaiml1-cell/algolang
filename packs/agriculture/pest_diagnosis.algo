// Agriculture · Pest and disease diagnosis
// Diagnose crop problems from symptoms
// AlgoLang domain pack agriculture.pest_diagnosis · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 4000
    retry 1
}

agent Entomologist(symptoms: text) -> text {
    role  "Entomologist specialist, pest and disease diagnosis"
    goal  "Identify likely pests from {symptoms}"
    uses  kb.search
}

agent Pathologist(symptoms: text) -> text {
    role  "Pathologist specialist, pest and disease diagnosis"
    goal  "Identify likely diseases from {symptoms}"
}

agent Agronomist(symptoms: text) -> text {
    role  "Agronomist specialist, pest and disease diagnosis"
    goal  "Identify nutrient or water stress from {symptoms}"
}

agent Panel(views: list) -> score {
    role  "Panel specialist, pest and disease diagnosis"
    goal  "Score diagnosis confidence 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
    }
}

agent Advice(views: list, verdict: score) -> text {
    role  "Advice specialist, pest and disease diagnosis"
    goal  "Write treatment advice from {views} with confidence {verdict}"
}

flow main(symptoms: text) {
    views   = par { Entomologist(symptoms), Pathologist(symptoms), Agronomist(symptoms) }
    verdict = Panel(views)
    report  = Advice(views, verdict)
    emit report, verdict
}
