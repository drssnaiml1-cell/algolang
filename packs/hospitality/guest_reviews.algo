// Hospitality & Travel · Guest review insights
// Turn guest reviews into actions
// AlgoLang domain pack hospitality.guest_reviews · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 3000
    retry 1
}

agent Splitter(reviews: text) -> list {
    role  "Splitter specialist, guest review insights"
    goal  "Split {reviews} into individual reviews"
    model fast
}

agent Analyst(part: text, reviews: text) -> text {
    role  "Analyst specialist, guest review insights"
    goal  "Extract service issues and praise from {part}"
}

agent Satisfaction(findings: list) -> score {
    role  "Satisfaction specialist, guest review insights"
    goal  "Score guest satisfaction 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Report(findings: list, level: score) -> text {
    role  "Report specialist, guest review insights"
    goal  "Write a guest experience report from {findings} with satisfaction {level}"
}

flow main(reviews: text) {
    parts    = Splitter(reviews)
    findings = par for part in parts { Analyst(part, reviews) }
    level    = Satisfaction(findings)
    report   = Report(findings, level)
    emit report, level
}
