// Hospitality & Travel · Itinerary planner
// Plan trips day by day
// AlgoLang domain pack hospitality.itinerary · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 3000
    retry 1
}

agent Planner(trip_request: text) -> text {
    role  "Planner specialist, itinerary planner"
    goal  "Draft a day-by-day itinerary for {trip_request}"
    uses  web.search
}

agent Logistics(draft: text) -> text {
    role  "Logistics specialist, itinerary planner"
    goal  "Check travel times and bookings for {draft}"
}

agent Fit(work: text) -> score {
    role  "Fit specialist, itinerary planner"
    goal  "Score fit to the request 0 to 1 of {work}"
    policy {
        require human when confidence < 0.70
    }
}

agent Final(work: text, level: score) -> text {
    role  "Final specialist, itinerary planner"
    goal  "Finalise the itinerary {work} with fit {level}"
}

flow main(trip_request: text) {
    first  = Planner(trip_request)
    work   = Logistics(first)
    level  = Fit(work)
    report = Final(work, level)
    emit report, level
}
