// Hospitality & Travel · Menu allergen check
// Allergen labelling for menus
// AlgoLang domain pack hospitality.allergen_check · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Ingredients(menu: text) -> text {
    role  "Ingredients specialist, menu allergen check"
    goal  "List ingredients of each dish in {menu}"
    uses  kb.search
}

agent Allergens(draft: text) -> text {
    role  "Allergens specialist, menu allergen check"
    goal  "Identify the 14 major allergens in {draft}"
}

agent Confidence(work: text) -> score {
    role  "Confidence specialist, menu allergen check"
    goal  "Score confidence in allergen labelling 0 to 1 for {work}"
    policy {
        require human when confidence < 0.90
    }
}

agent Labels(work: text, level: score) -> text {
    role  "Labels specialist, menu allergen check"
    goal  "Write allergen labels for {work} with confidence {level}"
}

flow main(menu: text) {
    first  = Ingredients(menu)
    work   = Allergens(first)
    level  = Confidence(work)
    report = Labels(work, level)
    emit report, level
}
