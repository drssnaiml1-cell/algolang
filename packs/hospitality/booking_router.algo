// Hospitality & Travel · Booking query router
// Route guest booking questions
// AlgoLang domain pack hospitality.booking_router · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 3000
    retry 1
}

agent IsChange(query: text) -> score {
    role  "Is change specialist, booking query router"
    goal  "Score 0 to 1 how likely this query is a booking change: {query}"
    model fast
}

agent Reservations(query: text) -> text {
    role  "Reservations specialist, booking query router"
    goal  "Handle this booking change: {query}"
    uses  kb.search
}

agent Concierge(query: text) -> text {
    role  "Concierge specialist, booking query router"
    goal  "Answer this guest question: {query}"
    uses  kb.search
}

agent Tone(reply: text) -> score {
    role  "Tone specialist, booking query router"
    goal  "Score 0 to 1 how warm and clear this reply is: {reply}"
    policy {
        require human when confidence < 0.70
    }
}

flow main(query: text) {
    if IsChange(query) >= 0.5 {
        reply = Reservations(query)
    } else {
        reply = Concierge(query)
    }
    quality = Tone(reply)
    if quality < 0.7 {
        reply = Reservations(query)
    }
    emit reply, quality
}
