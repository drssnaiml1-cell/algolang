// Hospitality & Travel · Loyalty offer designer
// Design loyalty offers by segment
// AlgoLang domain pack hospitality.loyalty_offers · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 3000
    retry 1
}

agent Insights(guest_segment: text) -> text {
    role  "Insights specialist, loyalty offer designer"
    goal  "Describe preferences of {guest_segment}"
    uses  calc.eval
}

agent Offers(draft: text) -> text {
    role  "Offers specialist, loyalty offer designer"
    goal  "Design three loyalty offers for {draft}"
}

agent Value(work: text) -> score {
    role  "Value specialist, loyalty offer designer"
    goal  "Score expected value 0 to 1 of {work}"
    policy {
        require human when confidence < 0.70
    }
}

agent Plan(work: text, level: score) -> text {
    role  "Plan specialist, loyalty offer designer"
    goal  "Write an offer plan from {work} with value {level}"
}

flow main(guest_segment: text) {
    first  = Insights(guest_segment)
    work   = Offers(first)
    level  = Value(work)
    report = Plan(work, level)
    emit report, level
}
