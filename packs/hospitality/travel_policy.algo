// Hospitality & Travel · Travel policy check
// Check business travel against policy
// AlgoLang domain pack hospitality.travel_policy · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 4000
    retry 1
}

agent Details(travel_request: text) -> text {
    role  "Details specialist, travel policy check"
    goal  "Extract dates, costs and class of travel from {travel_request}"
    uses  kb.search
}

agent Policy(draft: text) -> text {
    role  "Policy specialist, travel policy check"
    goal  "Check {draft} against the travel policy"
}

agent Compliance(work: text) -> score {
    role  "Compliance specialist, travel policy check"
    goal  "Score policy compliance 0 to 1 of {work}"
    policy {
        require human when confidence < 0.80
        forbid gender, caste, religion, nationality
    }
}

agent Decision(work: text, level: score) -> text {
    role  "Decision specialist, travel policy check"
    goal  "Write an approval note for {work} with compliance {level}"
}

flow main(travel_request: text) {
    first  = Details(travel_request)
    work   = Policy(first)
    level  = Compliance(work)
    report = Decision(work, level)
    emit report, level
}
