// Supply Chain & Logistics · Supplier risk monitoring
// Monitor supplier risk across the portfolio
// AlgoLang domain pack supplychain.supplier_risk · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 4000
    retry 1
}

agent Splitter(suppliers: text) -> list {
    role  "Splitter specialist, supplier risk monitoring"
    goal  "List the suppliers in {suppliers}"
    uses  web.search
    model fast
}

agent Analyst(part: text, suppliers: text) -> text {
    role  "Analyst specialist, supplier risk monitoring"
    goal  "Assess financial, geographic and compliance risk of {part}"
}

agent Risk(findings: list) -> score {
    role  "Risk specialist, supplier risk monitoring"
    goal  "Score portfolio supplier risk 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.80
    }
}

agent Report(findings: list, level: score) -> text {
    role  "Report specialist, supplier risk monitoring"
    goal  "Write a supplier risk report from {findings} with risk {level}"
}

flow main(suppliers: text) {
    parts    = Splitter(suppliers)
    findings = par for part in parts { Analyst(part, suppliers) }
    level    = Risk(findings)
    report   = Report(findings, level)
    emit report, level
}
