// Supply Chain & Logistics · Shipment exception router
// Route shipment exceptions by criticality
// AlgoLang domain pack supplychain.shipment_exceptions · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent Critical(exception: text) -> score {
    role  "Critical specialist, shipment exception router"
    goal  "Score 0 to 1 how critical this shipment exception is: {exception}"
    model fast
}

agent ControlTower(exception: text) -> text {
    role  "Control tower specialist, shipment exception router"
    goal  "Draft an expedite plan for: {exception}"
}

agent Carrier(exception: text) -> text {
    role  "Carrier specialist, shipment exception router"
    goal  "Draft a carrier follow-up for: {exception}"
}

agent Clarity(reply: text) -> score {
    role  "Clarity specialist, shipment exception router"
    goal  "Score 0 to 1 how actionable this plan is: {reply}"
    policy {
        require human when confidence < 0.80
    }
}

flow main(exception: text) {
    if Critical(exception) >= 0.5 {
        reply = ControlTower(exception)
    } else {
        reply = Carrier(exception)
    }
    quality = Clarity(reply)
    if quality < 0.7 {
        reply = ControlTower(exception)
    }
    emit reply, quality
}
