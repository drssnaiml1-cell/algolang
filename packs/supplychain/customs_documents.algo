// Supply Chain & Logistics · Customs document check
// Pre-check customs documents
// AlgoLang domain pack supplychain.customs_documents · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 6000
    retry 1
}

agent Documents(shipment_docs: text) -> list {
    role  "Documents specialist, customs document check"
    goal  "List the documents in {shipment_docs}"
    uses  file.read
    model fast
}

agent Checker(part: text, shipment_docs: text) -> text {
    role  "Checker specialist, customs document check"
    goal  "Check {part} for errors and missing data"
}

agent Readiness(findings: list) -> score {
    role  "Readiness specialist, customs document check"
    goal  "Score clearance readiness 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
    }
}

agent Corrections(findings: list, level: score) -> text {
    role  "Corrections specialist, customs document check"
    goal  "List corrections from {findings} with readiness {level}"
}

flow main(shipment_docs: text) {
    parts    = Documents(shipment_docs)
    findings = par for part in parts { Checker(part, shipment_docs) }
    level    = Readiness(findings)
    report   = Corrections(findings, level)
    emit report, level
}
