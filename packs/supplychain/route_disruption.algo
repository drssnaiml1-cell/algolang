// Supply Chain & Logistics · Route disruption response
// Respond to transport disruptions
// AlgoLang domain pack supplychain.route_disruption · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent Impact(disruption: text) -> text {
    role  "Impact specialist, route disruption response"
    goal  "Identify shipments affected by {disruption}"
}

agent Options(draft: text) -> text {
    role  "Options specialist, route disruption response"
    goal  "Propose alternative routes for {draft}"
}

agent Cost(work: text) -> score {
    role  "Cost specialist, route disruption response"
    goal  "Score cost impact 0 to 1 of {work}"
    policy {
        require human when confidence < 0.90
    }
}

agent Plan(work: text, level: score) -> text {
    role  "Plan specialist, route disruption response"
    goal  "Write a disruption response plan from {work} with impact {level}"
}

flow main(disruption: text) {
    first  = Impact(disruption)
    work   = Options(first)
    level  = Cost(work)
    report = Plan(work, level)
    emit report, level
}
