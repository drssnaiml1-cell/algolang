// Supply Chain & Logistics · Inventory rebalancing
// Rebalance stock between locations
// AlgoLang domain pack supplychain.inventory_rebalance · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 3000
    retry 1
}

agent Imbalances(stock_report: text) -> text {
    role  "Imbalances specialist, inventory rebalancing"
    goal  "Find overstock and stockout risks in {stock_report}"
    uses  calc.eval
}

agent Transfers(draft: text) -> text {
    role  "Transfers specialist, inventory rebalancing"
    goal  "Propose stock transfers for {draft}"
}

agent Benefit(work: text) -> score {
    role  "Benefit specialist, inventory rebalancing"
    goal  "Score benefit 0 to 1 of {work}"
    policy {
        require human when confidence < 0.70
    }
}

agent Plan(work: text, level: score) -> text {
    role  "Plan specialist, inventory rebalancing"
    goal  "Write a rebalancing plan from {work} with benefit {level}"
}

flow main(stock_report: text) {
    first  = Imbalances(stock_report)
    work   = Transfers(first)
    level  = Benefit(work)
    report = Plan(work, level)
    emit report, level
}
