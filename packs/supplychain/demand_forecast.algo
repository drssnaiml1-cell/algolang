// Supply Chain & Logistics · Demand forecast brief
// Consensus demand forecast briefs
// AlgoLang domain pack supplychain.demand_forecast · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 4000
    retry 1
}

agent Statistician(sales_history: text) -> text {
    role  "Statistician specialist, demand forecast brief"
    goal  "Describe trend and seasonality in {sales_history}"
    uses  calc.eval
}

agent MarketAnalyst(sales_history: text) -> text {
    role  "Market analyst specialist, demand forecast brief"
    goal  "Describe market drivers affecting {sales_history}"
}

agent SalesLead(sales_history: text) -> text {
    role  "Sales lead specialist, demand forecast brief"
    goal  "Describe pipeline signals in {sales_history}"
}

agent ForecastPanel(views: list) -> score {
    role  "Forecast panel specialist, demand forecast brief"
    goal  "Score forecast confidence 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
    }
}

agent Brief(views: list, verdict: score) -> text {
    role  "Brief specialist, demand forecast brief"
    goal  "Write a demand forecast brief from {views} with confidence {verdict}"
}

flow main(sales_history: text) {
    views   = par { Statistician(sales_history), MarketAnalyst(sales_history), SalesLead(sales_history) }
    verdict = ForecastPanel(views)
    report  = Brief(views, verdict)
    emit report, verdict
}
