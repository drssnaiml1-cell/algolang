// Cybersecurity · Access rights review
// Periodic least-privilege access reviews
// AlgoLang domain pack cyber.access_review · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 6000
    retry 1
}

agent Accounts(access_list: text) -> list {
    role  "Accounts specialist, access rights review"
    goal  "List the accounts and roles in {access_list}"
    uses  file.read
    model fast
}

agent Reviewer(part: text, access_list: text) -> text {
    role  "Reviewer specialist, access rights review"
    goal  "Check {part} for excessive or stale access"
}

agent Risk(findings: list) -> score {
    role  "Risk specialist, access rights review"
    goal  "Score access risk 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
    }
}

agent Actions(findings: list, level: score) -> text {
    role  "Actions specialist, access rights review"
    goal  "List revocations from {findings} with risk {level}"
}

flow main(access_list: text) {
    parts    = Accounts(access_list)
    findings = par for part in parts { Reviewer(part, access_list) }
    level    = Risk(findings)
    report   = Actions(findings, level)
    emit report, level
}
