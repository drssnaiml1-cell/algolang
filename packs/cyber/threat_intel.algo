// Cybersecurity · Threat intelligence brief
// Threat intelligence briefs for defenders
// AlgoLang domain pack cyber.threat_intel · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool web.search

policy {
    budget tokens 4000
    retry 1
}

agent Analyst(threat: text) -> text {
    role  "Analyst specialist, threat intelligence brief"
    goal  "Describe the threat actor and tactics in {threat}"
    uses  web.search
}

agent Defender(threat: text) -> text {
    role  "Defender specialist, threat intelligence brief"
    goal  "Map {threat} to defensive controls"
}

agent Hunter(threat: text) -> text {
    role  "Hunter specialist, threat intelligence brief"
    goal  "Suggest hunting queries for {threat}"
}

agent IntelPanel(views: list) -> score {
    role  "Intel panel specialist, threat intelligence brief"
    goal  "Score relevance to us 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
    }
}

agent Brief(views: list, verdict: score) -> text {
    role  "Brief specialist, threat intelligence brief"
    goal  "Write a threat brief from {views} with relevance {verdict}"
}

flow main(threat: text) {
    views   = par { Analyst(threat), Defender(threat), Hunter(threat) }
    verdict = IntelPanel(views)
    report  = Brief(views, verdict)
    emit report, verdict
}
