// Cybersecurity · Phishing email analysis
// Analyse suspicious emails
// AlgoLang domain pack cyber.phishing · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent Indicators(email: text) -> text {
    role  "Indicators specialist, phishing email analysis"
    goal  "List phishing indicators in {email}"
}

agent Assessment(draft: text) -> text {
    role  "Assessment specialist, phishing email analysis"
    goal  "Assess sender, links and intent in {draft}"
}

agent Likelihood(work: text) -> score {
    role  "Likelihood specialist, phishing email analysis"
    goal  "Score phishing likelihood 0 to 1 from {work}"
    policy {
        require human when confidence < 0.80
    }
}

agent Advice(work: text, level: score) -> text {
    role  "Advice specialist, phishing email analysis"
    goal  "Write user and SOC advice for {work} with likelihood {level}"
}

flow main(email: text) {
    first  = Indicators(email)
    work   = Assessment(first)
    level  = Likelihood(work)
    report = Advice(work, level)
    emit report, level
}
