// Cybersecurity · SOC alert triage
// Triage security alerts and summarise incidents
// AlgoLang domain pack cyber.soc_triage · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 6000
    retry 1
}

agent Batcher(alerts: text) -> list {
    role  "Batcher specialist, soc alert triage"
    goal  "Split {alerts} into individual alerts"
    uses  kb.search
    model fast
}

agent Analyst(part: text, alerts: text) -> text {
    role  "Analyst specialist, soc alert triage"
    goal  "Investigate {part} for indicators of compromise"
}

agent Severity(findings: list) -> score {
    role  "Severity specialist, soc alert triage"
    goal  "Score overall severity 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.90
    }
}

agent Incident(findings: list, level: score) -> text {
    role  "Incident specialist, soc alert triage"
    goal  "Write an incident summary from {findings} with severity {level}"
}

flow main(alerts: text) {
    parts    = Batcher(alerts)
    findings = par for part in parts { Analyst(part, alerts) }
    level    = Severity(findings)
    report   = Incident(findings, level)
    emit report, level
}
