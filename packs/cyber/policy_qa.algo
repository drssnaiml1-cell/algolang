// Cybersecurity · Security policy Q&A
// Answer staff security-policy questions
// AlgoLang domain pack cyber.policy_qa · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 3000
    retry 1
}

agent Finder(question: text) -> text {
    role  "Finder specialist, security policy q&a"
    goal  "Find policy passages relevant to {question}"
    uses  kb.search
}

agent Answer(draft: text) -> text {
    role  "Answer specialist, security policy q&a"
    goal  "Answer the question using {draft}"
}

agent Confidence(work: text) -> score {
    role  "Confidence specialist, security policy q&a"
    goal  "Score 0 to 1 how well {work} is supported by policy"
    policy {
        require human when confidence < 0.70
    }
}

agent Final(work: text, level: score) -> text {
    role  "Final specialist, security policy q&a"
    goal  "Finalise the answer {work} with support {level}"
}

flow main(question: text) {
    first  = Finder(question)
    work   = Answer(first)
    level  = Confidence(work)
    report = Final(work, level)
    emit report, level
}
