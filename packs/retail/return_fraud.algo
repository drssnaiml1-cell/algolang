// Retail & E-commerce · Return fraud screening
// Screen returns for abuse with fair review
// AlgoLang domain pack retail.return_fraud · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent PatternAnalyst(return_request: text) -> text {
    role  "Pattern analyst specialist, return fraud screening"
    goal  "Check {return_request} for return-abuse patterns"
}

agent OrderAnalyst(return_request: text) -> text {
    role  "Order analyst specialist, return fraud screening"
    goal  "Check order and delivery history in {return_request}"
}

agent PolicyChecker(return_request: text) -> text {
    role  "Policy checker specialist, return fraud screening"
    goal  "Check {return_request} against the returns policy"
}

agent Panel(views: list) -> score {
    role  "Panel specialist, return fraud screening"
    goal  "Score fraud likelihood 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
        forbid gender, caste, religion, nationality
    }
}

agent Decision(views: list, verdict: score) -> text {
    role  "Decision specialist, return fraud screening"
    goal  "Recommend an action from {views} with likelihood {verdict}"
}

flow main(return_request: text) {
    views   = par { PatternAnalyst(return_request), OrderAnalyst(return_request), PolicyChecker(return_request) }
    verdict = Panel(views)
    report  = Decision(views, verdict)
    emit report, verdict
}
