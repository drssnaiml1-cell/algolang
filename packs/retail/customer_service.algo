// Retail & E-commerce · Customer service router
// Route customer messages to the right desk
// AlgoLang domain pack retail.customer_service · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 3000
    retry 1
}

agent IsOrder(message: text) -> score {
    role  "Is order specialist, customer service router"
    goal  "Score 0 to 1 how likely this message is about an order: {message}"
    model fast
}

agent OrderDesk(message: text) -> text {
    role  "Order desk specialist, customer service router"
    goal  "Resolve this order or delivery issue: {message}"
    uses  kb.search
}

agent HelpDesk(message: text) -> text {
    role  "Help desk specialist, customer service router"
    goal  "Answer this product or account question: {message}"
    uses  kb.search
}

agent Tone(reply: text) -> score {
    role  "Tone specialist, customer service router"
    goal  "Score 0 to 1 how friendly and clear this reply is: {reply}"
    policy {
        require human when confidence < 0.70
    }
}

flow main(message: text) {
    if IsOrder(message) >= 0.5 {
        reply = OrderDesk(message)
    } else {
        reply = HelpDesk(message)
    }
    quality = Tone(reply)
    if quality < 0.7 {
        reply = OrderDesk(message)
    }
    emit reply, quality
}
