// Retail & E-commerce · Catalogue quality audit
// Audit product catalogue quality
// AlgoLang domain pack retail.catalog_quality · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 3000
    retry 1
}

agent Items(catalog: text) -> list {
    role  "Items specialist, catalogue quality audit"
    goal  "List the catalogue entries in {catalog}"
    model fast
}

agent Auditor(part: text, catalog: text) -> text {
    role  "Auditor specialist, catalogue quality audit"
    goal  "Check {part} for missing attributes, errors and policy issues"
}

agent Quality(findings: list) -> score {
    role  "Quality specialist, catalogue quality audit"
    goal  "Score catalogue quality 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Fixes(findings: list, level: score) -> text {
    role  "Fixes specialist, catalogue quality audit"
    goal  "List fixes from {findings} with quality {level}"
}

flow main(catalog: text) {
    parts    = Items(catalog)
    findings = par for part in parts { Auditor(part, catalog) }
    level    = Quality(findings)
    report   = Fixes(findings, level)
    emit report, level
}
