// Retail & E-commerce · Product description writer
// Write accurate product descriptions
// AlgoLang domain pack retail.product_description · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 3000
    retry 1
}

agent Features(product: text) -> text {
    role  "Features specialist, product description writer"
    goal  "List features and benefits of {product}"
}

agent Writer(draft: text) -> text {
    role  "Writer specialist, product description writer"
    goal  "Write an engaging product description from {draft}"
}

agent Accuracy(work: text) -> score {
    role  "Accuracy specialist, product description writer"
    goal  "Score 0 to 1 the factual accuracy of {work}"
    policy {
        require human when confidence < 0.70
    }
}

agent Final(work: text, level: score) -> text {
    role  "Final specialist, product description writer"
    goal  "Finalise the description {work} with accuracy {level}"
}

flow main(product: text) {
    first  = Features(product)
    work   = Writer(first)
    level  = Accuracy(work)
    report = Final(work, level)
    emit report, level
}
