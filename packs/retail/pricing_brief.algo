// Retail & E-commerce · Pricing recommendation
// Evidence-based pricing recommendations
// AlgoLang domain pack retail.pricing_brief · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool calc.eval

policy {
    budget tokens 4000
    retry 1
}

agent CostAnalyst(product_data: text) -> text {
    role  "Cost analyst specialist, pricing recommendation"
    goal  "Assess cost and margin in {product_data}"
    uses  calc.eval
}

agent CompetitorAnalyst(product_data: text) -> text {
    role  "Competitor analyst specialist, pricing recommendation"
    goal  "Assess competitor prices in {product_data}"
}

agent DemandAnalyst(product_data: text) -> text {
    role  "Demand analyst specialist, pricing recommendation"
    goal  "Assess price sensitivity in {product_data}"
}

agent PricingPanel(views: list) -> score {
    role  "Pricing panel specialist, pricing recommendation"
    goal  "Score confidence in a price change 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
    }
}

agent Brief(views: list, verdict: score) -> text {
    role  "Brief specialist, pricing recommendation"
    goal  "Write a pricing recommendation from {views} with confidence {verdict}"
}

flow main(product_data: text) {
    views   = par { CostAnalyst(product_data), CompetitorAnalyst(product_data), DemandAnalyst(product_data) }
    verdict = PricingPanel(views)
    report  = Brief(views, verdict)
    emit report, verdict
}
