// Education · AI tutor
// Explain topics with examples for students
// AlgoLang domain pack education.ai_tutor · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 3000
    retry 1
}

agent Explainer(topic: text) -> text {
    role  "Explainer specialist, ai tutor"
    goal  "Explain {topic} to a first-year student in 6 sentences"
}

agent Examples(draft: text) -> text {
    role  "Examples specialist, ai tutor"
    goal  "Add two worked examples to {draft}"
}

agent Accuracy(work: text) -> score {
    role  "Accuracy specialist, ai tutor"
    goal  "Score 0 to 1 the accuracy of {work}"
    policy {
        require human when confidence < 0.70
    }
}

agent Lesson(work: text, level: score) -> text {
    role  "Lesson specialist, ai tutor"
    goal  "Finalise the lesson {work} noting accuracy {level}"
}

flow main(topic: text) {
    first  = Explainer(topic)
    work   = Examples(first)
    level  = Accuracy(work)
    report = Lesson(work, level)
    emit report, level
}
