// Education · Course outcome mapping
// Map course outcomes to programme outcomes for accreditation
// AlgoLang domain pack education.outcome_mapping · risk: low · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool file.read

policy {
    budget tokens 3000
    retry 1
}

agent Outcomes(course: text) -> list {
    role  "Outcomes specialist, course outcome mapping"
    goal  "List the course outcomes of {course}"
    uses  file.read
    model fast
}

agent Mapper(part: text, course: text) -> text {
    role  "Mapper specialist, course outcome mapping"
    goal  "Map {part} to programme outcomes and Bloom's level"
}

agent Alignment(findings: list) -> score {
    role  "Alignment specialist, course outcome mapping"
    goal  "Score outcome alignment 0 to 1 from {findings}"
    policy {
        require human when confidence < 0.70
    }
}

agent Matrix(findings: list, level: score) -> text {
    role  "Matrix specialist, course outcome mapping"
    goal  "Write a CO-PO mapping summary from {findings} with alignment {level}"
}

flow main(course: text) {
    parts    = Outcomes(course)
    findings = par for part in parts { Mapper(part, course) }
    level    = Alignment(findings)
    report   = Matrix(findings, level)
    emit report, level
}
