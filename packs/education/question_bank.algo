// Education · Exam question bank
// Generate exam questions mapped to syllabus units
// AlgoLang domain pack education.question_bank · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent Units(syllabus: text) -> list {
    role  "Units specialist, exam question bank"
    goal  "List the units of {syllabus}"
    model fast
}

agent Setter(part: text, syllabus: text) -> text {
    role  "Setter specialist, exam question bank"
    goal  "Write 5 exam questions at different Bloom's levels for {part}"
}

agent Coverage(findings: list) -> score {
    role  "Coverage specialist, exam question bank"
    goal  "Score 0 to 1 how well {findings} cover the syllabus"
    policy {
        require human when confidence < 0.80
    }
}

agent Paper(findings: list, level: score) -> text {
    role  "Paper specialist, exam question bank"
    goal  "Assemble a question paper from {findings} with coverage {level}"
}

flow main(syllabus: text) {
    parts    = Units(syllabus)
    findings = par for part in parts { Setter(part, syllabus) }
    level    = Coverage(findings)
    report   = Paper(findings, level)
    emit report, level
}
