// Education · Student support router
// Route student queries to support or the academic office
// AlgoLang domain pack education.student_support · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"
tool kb.search

policy {
    budget tokens 4000
    retry 1
}

agent Wellbeing(query: text) -> score {
    role  "Wellbeing specialist, student support router"
    goal  "Score 0 to 1 how much this student query needs wellbeing support: {query}"
    model fast
}

agent Counsellor(query: text) -> text {
    role  "Counsellor specialist, student support router"
    goal  "Draft a caring reply and connect to campus support for: {query}"
    uses  kb.search
}

agent Office(query: text) -> text {
    role  "Office specialist, student support router"
    goal  "Answer this academic or administrative query: {query}"
    uses  kb.search
}

agent Care(reply: text) -> score {
    role  "Care specialist, student support router"
    goal  "Score 0 to 1 how kind and helpful this reply is: {reply}"
    policy {
        require human when confidence < 0.80
    }
}

flow main(query: text) {
    if Wellbeing(query) >= 0.5 {
        reply = Counsellor(query)
    } else {
        reply = Office(query)
    }
    quality = Care(reply)
    if quality < 0.7 {
        reply = Counsellor(query)
    }
    emit reply, quality
}
