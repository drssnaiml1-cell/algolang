// Education · Essay feedback
// Moderated essay feedback with integrity checks
// AlgoLang domain pack education.essay_feedback · risk: medium · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 4000
    retry 1
}

agent ContentExaminer(essay: text) -> text {
    role  "Content examiner specialist, essay feedback"
    goal  "Assess argument and evidence in {essay}"
}

agent LanguageExaminer(essay: text) -> text {
    role  "Language examiner specialist, essay feedback"
    goal  "Assess language and structure in {essay}"
}

agent IntegrityChecker(essay: text) -> text {
    role  "Integrity checker specialist, essay feedback"
    goal  "Check {essay} for referencing and integrity issues"
}

agent Moderator(views: list) -> score {
    role  "Moderator specialist, essay feedback"
    goal  "Score the essay 0 to 1 from {views}"
    policy {
        require human when confidence < 0.80
        forbid gender, caste, religion, nationality
    }
}

agent Feedback(views: list, verdict: score) -> text {
    role  "Feedback specialist, essay feedback"
    goal  "Write constructive feedback from {views} with score {verdict}"
}

flow main(essay: text) {
    views   = par { ContentExaminer(essay), LanguageExaminer(essay), IntegrityChecker(essay) }
    verdict = Moderator(views)
    report  = Feedback(views, verdict)
    emit report, verdict
}
