// Education · Admissions screening
// Panel-style admissions screening with fairness safeguards
// AlgoLang domain pack education.admissions · risk: high · generated by tools/make_packs.py

model smart = "claude-sonnet-5-5"
model fast  = "claude-haiku-5-5"

policy {
    budget tokens 6000
    retry 1
}

agent AcademicReviewer(application: text) -> text {
    role  "Academic reviewer specialist, admissions screening"
    goal  "Assess academic record in {application}"
}

agent StatementReviewer(application: text) -> text {
    role  "Statement reviewer specialist, admissions screening"
    goal  "Assess the statement of purpose in {application}"
}

agent PotentialReviewer(application: text) -> text {
    role  "Potential reviewer specialist, admissions screening"
    goal  "Assess potential and achievements in {application}"
}

agent AdmissionsPanel(views: list) -> score {
    role  "Admissions panel specialist, admissions screening"
    goal  "Score admission recommendation 0 to 1 from {views}"
    policy {
        require human when confidence < 0.90
        forbid gender, caste, religion, nationality
    }
}

agent Letter(views: list, verdict: score) -> text {
    role  "Letter specialist, admissions screening"
    goal  "Write a panel summary from {views} with score {verdict}"
}

flow main(application: text) {
    views   = par { AcademicReviewer(application), StatementReviewer(application), PotentialReviewer(application) }
    verdict = AdmissionsPanel(views)
    report  = Letter(views, verdict)
    emit report, verdict
}
