% ── shields.io-style badges ───────────────────────────────────────────
\newcommand{\badge}[3][gold]{%
  \tikz[baseline=(L.base)]{%
    \node[fill=navy2,text=white,font=\sffamily\scriptsize,inner xsep=5pt,inner ysep=3.2pt,
          anchor=east,text height=1.6ex,text depth=0.4ex](L) at (0,0){#2};
    \node[fill=#1,text=navy,font=\sffamily\scriptsize\bfseries,inner xsep=5pt,inner ysep=3.2pt,
          anchor=west,text height=1.6ex,text depth=0.4ex](R) at (0,0){#3};
  }}

% ── logo: an agent network inside a gold ring ─────────────────────────
\newcommand{\algologo}[1][1]{%
  \begin{tikzpicture}[scale=#1,every node/.style={transform shape}]
    \draw[gold,line width=2.2pt] (0,0) circle (1.55);
    \draw[gold!60,line width=0.6pt] (0,0) circle (1.38);
    \coordinate (A) at (90:0.82);  \coordinate (B) at (210:0.82); \coordinate (C) at (330:0.82);
    \coordinate (O) at (0,0);
    \draw[white,line width=1.4pt] (A)--(B)--(C)--cycle;
    \draw[white,line width=1.0pt] (A)--(O) (B)--(O) (C)--(O);
    \foreach \p in {A,B,C}{\fill[white] (\p) circle (0.22); \fill[navy] (\p) circle (0.11);}
    \fill[gold] (O) circle (0.28);
    \fill[navy] (O) circle (0.12);
  \end{tikzpicture}}

