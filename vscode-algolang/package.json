{
  "name": "algolang",
  "displayName": "AlgoLang",
  "description": "AlgoLang (.algo) for VS Code: syntax highlighting plus the AlgoLang language server (diagnostics, hover, completion, go to definition, outline)",
  "version": "0.3.2",
  "publisher": "algoprofessor",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "algolang",
        "aliases": [
          "AlgoLang",
          "algo"
        ],
        "extensions": [
          ".algo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "algolang",
        "scopeName": "source.algolang",
        "path": "./syntaxes/algolang.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "AlgoLang",
      "properties": {
        "algolang.server.command": {
          "type": "string",
          "default": "algo",
          "description": "Command that starts the AlgoLang tools (the `algo` installed by pip or the installer)."
        },
        "algolang.server.args": {
          "type": "array",
          "default": [
            "lsp"
          ],
          "items": {
            "type": "string"
          },
          "description": "Arguments for the language server."
        },
        "algolang.server.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the AlgoLang language server."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:algolang"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/drssnaiml1-cell/algolang"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "scripts": {
    "package": "npx @vscode/vsce package"
  }
}